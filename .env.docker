# Docker environment for curodav
# Copy this to .env and fill in real values.

# Radicale credentials (must match what you put in the htpasswd file)
CC_RADICALE_USER=curodav
CC_RADICALE_PASSWORD=changeme

# Deploy mode: "production" forces first-run setup flow
CC_DEPLOY_MODE=production

# App authentication (set both to enable login)
# CC_AUTH_USERNAME=admin
# CC_AUTH_PASSWORD=changeme
