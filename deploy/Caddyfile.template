# Rendered by install-caddy.sh (sed substitution of {{DOMAIN_APP}}/
# {{DOMAIN_DAV}}/{{LE_EMAIL}} from deploy.env) into /etc/caddy/Caddyfile.
# Don't edit /etc/caddy/Caddyfile by hand and expect it to survive a re-run
# of install-caddy.sh -- edit this template (or deploy.env) instead.

{
	email {{LE_EMAIL}}
}

# Command Center Web itself. curodav.service (scripts/curodav-ctl) already
# binds 0.0.0.0:8000 -- Caddy is meant to be the ONLY thing that ever
# reaches it from outside the host; firewall.sh is what actually enforces
# that (uvicorn's own bind address doesn't restrict to loopback here, the
# port is just never opened to the outside world).
{{DOMAIN_APP}} {
	reverse_proxy 127.0.0.1:8000

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Radicale (CalDAV/CardDAV) -- what DAVx5 syncs against. radicale.service
# binds 127.0.0.1:5232 only (radicale/config.template's hosts= line), so
# this reverse proxy is the one and only way in from outside, TLS
# terminated here and forwarded as plain HTTP over loopback.
{{DOMAIN_DAV}} {
	reverse_proxy 127.0.0.1:5232

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}

	# Radicale's own PROPFIND/REPORT bodies can run larger than Caddy's
	# default -- DAVx5 syncing a big contacts collection has been known to
	# trip default body-size limits on some proxies. Generous, not
	# unlimited.
	request_body {
		max_size 50MB
	}
}
