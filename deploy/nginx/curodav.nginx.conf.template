# Installed to /etc/nginx/sites-available/curodav by install-nginx.sh.
# Loopback-only path router: cloudflared's single ingress rule points at
# 127.0.0.1:8080, and this splits traffic by path:
#   /radicale/*      -> radicale.service (127.0.0.1:5232)
#   everything else  -> curodav.service (127.0.0.1:8000)
server {
    listen 127.0.0.1:8080;
    server_name _;

    client_max_body_size 50M;

    # Clients hitting bare "/radicale" (no trailing slash) would otherwise
    # fall through to `location /` and get silently routed to the app
    # instead of Radicale.
    location = /radicale {
        return 301 /radicale/;
    }

    location /radicale/ {
        # 2026-09-13 direct request (Radicale has no brute-force/lockout
        # protection of its own) -- caps request rate per real client IP,
        # using the zone defined in curodav-ratelimit.conf (installed
        # separately to /etc/nginx/conf.d/, see that file's own comment for
        # why $http_cf_connecting_ip and not nginx's own $remote_addr).
        # burst=40 absorbs one full DAVx5/Thunderbird/iOS sync cycle's
        # handful of PROPFIND/REPORT/GET requests with no delay; only a
        # SUSTAINED rate above 10r/m starts queuing/rejecting (429) requests.
        limit_req zone=curodav_radicale burst=40 nodelay;
        proxy_pass http://127.0.0.1:5232;
        proxy_set_header Host $host;
        # Do NOT let proxy_pass strip the /radicale/ prefix -- Radicale needs
        # the original full path to compute correct href values in its
        # WebDAV responses. X-Script-Name tells it what prefix to expect instead.
        proxy_set_header X-Script-Name /radicale;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
    }
}
