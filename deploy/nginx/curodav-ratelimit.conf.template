# Installed to /etc/nginx/conf.d/curodav-ratelimit.conf by install-nginx.sh,
# with {{IP_SOURCE}} substituted for the real nginx variable to key rate
# limiting on -- see that script's own comment for how it picks the value.
# `limit_req_zone` has to live in nginx's `http {}` context -- Debian's
# stock /etc/nginx/nginx.conf already `include`s conf.d/*.conf from inside
# that block, same as it includes sites-enabled/*, so this file just needs
# to exist here; nothing else has to be touched by hand.
#
# Why this exists: Radicale's own auth (htpasswd + bcrypt,
# radicale/config.template) has no rate limiting or lockout of its own --
# unlike curodav's own login (see src/auth.py's login_rate_limited, a
# 5-attempts-per-15-minutes per-IP throttle), an unlimited number of
# password guesses can be thrown at it. This is the mitigation for that
# gap: nginx caps the request rate PER CLIENT IP to the /radicale/*
# location (curodav.nginx.conf.template's own `limit_req` line references
# this zone), throttling a sustained guessing loop without materially
# affecting a real DAVx5/Thunderbird/iOS client's normal sync traffic.
#
# {{IP_SOURCE}} (2026-09-18, was hardcoded to $http_cf_connecting_ip):
# behind an actual Cloudflare Tunnel (the default, 'install --dav'
# without --proxy=manual), the only thing that ever connects to nginx
# here is cloudflared, over loopback, so nginx's own view of the client
# (`$remote_addr`) is ALWAYS 127.0.0.1 regardless of who's actually
# hitting the public hostname -- `CF-Connecting-IP` is Cloudflare's own
# header carrying the real, authoritative client IP instead (Cloudflare's
# edge sets it from the actual TCP connection and overwrites any
# client-supplied value of the same name before it ever reaches this
# tunnel, so it can't be spoofed). A manual/non-Cloudflare reverse proxy
# ('install --dav --proxy=manual') has no such header contract this
# script can rely on, so install-nginx.sh substitutes $remote_addr there
# instead -- correct as long as that proxy also reaches nginx over
# loopback on this same host without faking `Host`/forwarding headers of
# its own; a different setup may need to hand-edit the installed
# /etc/nginx/conf.d/curodav-ratelimit.conf afterward (see deploy/README.md's
# "Bringing your own reverse proxy" section).
# `map` with a default keeps this from ever using an empty key (a request
# that somehow arrives without the header, e.g. someone testing directly
# against a leaked port) -- those all share one "unknown" bucket rather
# than each getting their own unlimited free pass.
map {{IP_SOURCE}} $curodav_ratelimit_key {
    default {{IP_SOURCE}};
    ""      "unknown";
}

# 10 requests/minute sustained per IP, ~1 every 6s -- generous enough that
# it's never hit by normal use (a DAVx5/Thunderbird/iOS sync cycle bursts
# a handful of PROPFIND/REPORT/GET requests then goes idle until its next
# interval; curodav.nginx.conf.template's own `limit_req ... burst=40
# nodelay` absorbs that burst without any delay), but turns an unattended
# password-guessing loop from "unlimited attempts" into "at most ~14,400/
# day" -- combined with bcrypt's own per-attempt cost, a meaningfully
# harder target than no limit at all. 10m zone size is enough tracked IPs
# for a single-user app's realistic traffic (nginx's own docs: ~1MB holds
# ~16,000 IP states) many times over.
limit_req_zone $curodav_ratelimit_key zone=curodav_radicale:10m rate=10r/m;
limit_req_status 429;
