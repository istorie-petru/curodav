# Copy to .env and fill in real values, then:
#   ./create-radicale-user.sh   # one-time: writes the Radicale auth file
#   docker compose up -d --build
# Full walkthrough: https://github.com/istorie-petru/curodav/wiki/Deploying-with-Docker

# Port the app is reachable on from the host (http://localhost:APP_PORT).
APP_PORT=8000

# The single Radicale (CalDAV/CardDAV sync) user this app authenticates as.
RADICALE_USER=curodav
RADICALE_PASSWORD=change-me

# Session secret for login cookies -- generate with: openssl rand -hex 32
CC_AUTH_SECRET=change-me-too
