# Command Center Web (curodav) configuration -- Docker deploy.
#
# Copied to /etc/curodav/curodav.env on first install (and auto-detected by
# the compose file if it exists). The install script never overwrites an
# existing file. You can also skip it entirely: with no env file the app
# uses its built-in defaults, and the SQLite cache still lands inside the
# container's data volume (the volume is mounted on the app user's home).
#
# Everything here is optional.

# Where the SQLite cache + backups live inside the container.
CC_DB_PATH=/var/lib/curodav/.command_center_web/cache.sqlite
CC_BACKUP_DIR=/var/lib/curodav/.command_center_web/backups

# How often (seconds) the background thread pulls changes from Radicale.
CC_SYNC_INTERVAL=60

# Single-user login -- the image sets CC_DEPLOY_MODE=production (see the
# Dockerfile, not this file), so if you leave both of these unset the app
# forces a first-run setup page (GET/POST /setup) where you pick the
# account yourself before anything else works. Set BOTH lines here instead
# if you'd rather pre-configure the account (e.g. a scripted install) and
# skip that page entirely.
#   CC_AUTH_USERNAME=you
#   CC_AUTH_PASSWORD=your-password
# Optional: an explicit session-signing key. Unset = auto-generated once
# and stored in the app DB (change it to force everyone to re-login).
#   CC_AUTH_SECRET=some-long-random-string

# CalDAV/CardDAV sync against the companion Radicale container -- OPTIONAL.
# Enable the profile, then uncomment and edit these:
#   docker compose --profile sync up -d
#   CC_RADICALE_URL=http://radicale:5232/curodav/
#   CC_RADICALE_USER=curodav
#   CC_RADICALE_PASSWORD=...
#   CC_CALENDAR_COLLECTION=calendar
#   CC_TASKS_COLLECTION=tasks
#   CC_CONTACTS_COLLECTION=contacts