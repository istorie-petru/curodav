; Mounted read-only into the radicale container at /etc/radicale/config.
; Binds 0.0.0.0 rather than loopback -- unlike the systemd deploy
; (deploy/radicale/config.template), there's no shared loopback here: app
; and radicale are separate containers on their own Docker network, and
; docker-compose.yml never publishes 5232 to the host, so this is only
; ever reachable from the app container, not the internet.
[server]
hosts = 0.0.0.0:5232

[auth]
type = htpasswd
htpasswd_filename = /data/users
htpasswd_encryption = bcrypt

[storage]
filesystem_folder = /data/collections

[rights]
; Single-user app: each authenticated user only ever sees their own collections.
type = owner_only

[logging]
level = warning
