# Copy to deploy.env and fill in real values. Gitignored -- no secrets end
# up here (the tunnel's own credentials are a JSON file cloudflared writes
# itself; the Radicale password is set interactively).
#
# Order of operations (see deploy/README.md):
#   1. Domain's nameservers already point at Cloudflare.
#   2. cp deploy.env.example deploy.env, edit the values below.
#   3. sudo ./firewall.sh
#   4. sudo ./radicale/install-radicale.sh
#   5. sudo ./nginx/install-nginx.sh
#   6. sudo ./cloudflared/install-cloudflared.sh
#   7. Fill in CC_RADICALE_URL/USER/PASSWORD in /srv/curodav/shared/.env, restart curodav.

# Public hostname for the webapp -- and for Radicale, reachable at
# https://DOMAIN_APP/radicale/, a path under this same hostname.
DOMAIN_APP=app.example.com

# Cloudflare Tunnel name (Zero Trust dashboard > Networks > Tunnels).
TUNNEL_NAME=curodav

# The single Radicale user this app authenticates as. Use the same value
# for CC_RADICALE_USER in /srv/curodav/shared/.env.
RADICALE_USER=curodav
