; Production Radicale config, installed to /srv/radicale/config by
; install-radicale.sh. Only reachable from outside through local nginx's
; /radicale/ path (itself only reachable through the Cloudflare Tunnel);
; `hosts` below binds loopback only.

[server]
hosts = 127.0.0.1:5232

[auth]
type = htpasswd
htpasswd_filename = /srv/radicale/users
htpasswd_encryption = bcrypt

[storage]
filesystem_folder = /srv/radicale/collections

[rights]
; Single-user app: each authenticated user only ever sees their own collections.
type = owner_only

[logging]
level = warning
