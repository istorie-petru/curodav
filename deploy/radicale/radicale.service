# Installed to /etc/systemd/system/radicale.service by install-radicale.sh.
[Unit]
Description=Radicale (CalDAV/CardDAV) -- backs curodav's Published Lists + DAVx5 sync
Documentation=https://radicale.org/v3.html
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=radicale
Group=radicale
WorkingDirectory=/srv/radicale
ExecStart=/srv/radicale/venv/bin/python -m radicale --config /srv/radicale/config
Restart=on-failure
RestartSec=3

# Hardening. 2026-09-18 (image/deploy standardization pass): brought up to
# the same baseline already applied to sibling app Pineart's artboard.service/
# searxng.service and this app's own cloudflared.service -- this unit had
# been left at the original, shallower set.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/radicale
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
