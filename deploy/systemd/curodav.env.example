# Command Center Web (curodav) configuration.
#
# Copied to /etc/curodav/curodav.env on first install. The install script
# NEVER overwrites an existing file, so edits here survive updates.
#
# Every variable is optional -- the app runs with its built-in defaults
# (see webapp/src/config.py). Uncomment/edit what you need.

# SQLite cache + Data-health backups -- the app's primary local store.
# Both directories must be writable by the curodav user (the install script
# creates them with the right ownership).
CC_DB_PATH=/var/lib/curodav/data/cache.sqlite
CC_BACKUP_DIR=/var/lib/curodav/data/backups

# How often (seconds) the background thread pulls changes from Radicale.
CC_SYNC_INTERVAL=60

# Single-user login -- this deploy is CC_DEPLOY_MODE=production (set in
# curodav.service, not here), so if you leave both of these unset the app
# forces a first-run setup page (GET/POST /setup) where you pick the
# account yourself before anything else works. Set BOTH lines here instead
# if you'd rather pre-configure the account (e.g. a scripted install) and
# skip that page entirely.
#   CC_AUTH_USERNAME=you
#   CC_AUTH_PASSWORD=your-password
# Optional: an explicit session-signing key. Unset = auto-generated once
# and stored in the app DB (change it to force everyone to re-login).
#   CC_AUTH_SECRET=some-long-random-string

# CalDAV/CardDAV sync against a Radicale server -- OPTIONAL. The app runs
# standalone without it. To enable: `sudo bash deploy/systemd/install.sh
# --with-radicale` (install.sh generates these three lines for you):
# CC_RADICALE_URL=http://127.0.0.1:5232/curodav/
# CC_RADICALE_USER=curodav
# CC_RADICALE_PASSWORD=...
# CC_CALENDAR_COLLECTION=calendar
# CC_TASKS_COLLECTION=tasks
# CC_CONTACTS_COLLECTION=contacts