# Command Center Web (curodav) -- FastAPI app served by uvicorn.
#
# Installed by deploy/systemd/install.sh. The unit is copied verbatim from
# the repo on every install/update, so keep edits in this file (or a drop-in
# at /etc/systemd/system/curodav.service.d/) instead of editing the installed
# copy directly.
#
# Security note: the app has no auth of its own. Keep it on a trusted
# network (e.g. Tailscale) or put an authenticated reverse proxy in front.
[Unit]
Description=Command Center Web (curodav) -- personal organizer PWA
Documentation=https://github.com/istorie-petru/curodav
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=curodav
Group=curodav
WorkingDirectory=/opt/curodav/webapp
# All configuration lives in env vars (see /etc/curodav/curodav.env).
EnvironmentFile=/etc/curodav/curodav.env
# The venv is created by `uv sync` inside the repo (see install.sh). The app
# is not pip-installed, so PYTHONPATH must point at its own src/ tree.
Environment=PYTHONPATH=/opt/curodav/webapp/src
# --proxy-headers: trust X-Forwarded-* from a reverse proxy / Tailscale.
ExecStart=/opt/curodav/.venv/bin/python -m uvicorn src.main:app --host 0.0.0.0 --port 8000 --proxy-headers
Restart=on-failure
RestartSec=3

# Light hardening. The app writes only to /var/lib/curodav (SQLite cache,
# Data-health backups, optional Radicale collections); /opt is read-only.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target