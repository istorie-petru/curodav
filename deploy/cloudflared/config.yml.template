# Rendered by install-cloudflared.sh into /etc/cloudflared/config.yml.
# Re-run install-cloudflared.sh (not a manual edit) if DOMAIN_APP changes.

tunnel: {{TUNNEL_ID}}
credentials-file: /etc/cloudflared/{{TUNNEL_ID}}.json

ingress:
  # nginx listens here and fans out by path: /radicale/* to Radicale,
  # everything else to curodav (see ../nginx/curodav.nginx.conf.template).
  - hostname: {{DOMAIN_APP}}
    service: http://127.0.0.1:8080

  # Required catch-all -- cloudflared refuses to start without one.
  - service: http_status:404
