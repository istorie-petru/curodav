#!/usr/bin/env bash
# curodav-ctl -- install / update / remove curodav on a Debian 12 host,
# systemd-managed, release/symlink deploys.
#
#   sudo /path/to/repo/scripts/curodav-ctl install   # first install (bootstrap from a clone)
#   sudo curodav-ctl update                          # deploy latest main, atomic swap, auto-rollback
#   sudo curodav-ctl install --dav [--proxy=cloudflare|manual] [--reconfigure]
#                                                     # add/reconfigure public CalDAV/CardDAV (see deploy/README.md)
#                                                     # --proxy=manual skips Cloudflare Tunnel entirely, for anyone
#                                                     # fronting this with their own reverse proxy/tunnel instead
#                                                     # --reconfigure re-prompts for DOMAIN_APP/TUNNEL_NAME/RADICALE_USER
#                                                     # and rotates the Radicale password; without it, a re-run of
#                                                     # 'install --dav' reuses whatever was set last time, no re-prompting
#       curodav-ctl status                            # just the reachability/consistency checks below, no deploy
#   sudo curodav-ctl revert                          # swap current -> previous locally, restart, health-check
#   sudo curodav-ctl remove                          # tear down (destructive, confirms)
#
# Layout:
#   /srv/curodav/releases/release_<timestamp>_<hash>/   one per deploy
#   /srv/curodav/current -> releases/<latest>            atomically swapped
#   /srv/curodav/previous -> releases/<prior>             rollback target
#   /srv/curodav/shared/.env                              EnvironmentFile
#   /srv/curodav/shared/repo_url                          persisted origin URL
#   /srv/curodav/shared/deploy.env                        persisted DAV domain/tunnel name
#   /srv/curodav/shared/data/                             SQLite cache + backups
set -euo pipefail

APP_NAME="curodav"
APP_USER="curodav"
GIT_BRANCH="main"
TARGET_PORT=8000
# 2026-09-17 (design-system unification pass, deploy alignment with
# sibling app Pineart's artboard-ctl, which already checks /api/health):
# was "/", which happened to work (any 2xx counts) but isn't a real
# liveness signal -- a half-broken app can still render a page shell at
# "/". src/main.py now exposes a dedicated GET /health for this.
HEALTH_PATH="/health"
KEEP_RELEASES=5
UV_INSTALL_DIR="/usr/local/bin"
INSTALLED_CTL="/usr/local/bin/${APP_NAME}-ctl"

BASE_DIR="/srv/${APP_NAME}"
RELEASES_DIR="${BASE_DIR}/releases"
SHARED_DIR="${BASE_DIR}/shared"
DATA_DIR="${SHARED_DIR}/data"
CURRENT_LINK="${BASE_DIR}/current"
PREVIOUS_LINK="${BASE_DIR}/previous"
ENV_FILE="${SHARED_DIR}/.env"
REPO_URL_FILE="${SHARED_DIR}/repo_url"
UNIT_FILE="/etc/systemd/system/${APP_NAME}.service"

DEPLOY_ENV_FILE="${SHARED_DIR}/deploy.env"
RADICALE_PORT=5232
RADICALE_USERS_FILE="/srv/radicale/users"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
log()  { echo -e "${GREEN}==>${NC} $*"; }
warn() { echo -e "${YELLOW}==>${NC} $*"; }
err()  { echo -e "${RED}==>${NC} $*" >&2; }

require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    err "curodav-ctl must run as root (sudo)."
    exit 1
  fi
}

prompt_default() {
  local prompt="$1" default="$2" reply
  if [ -n "$default" ]; then
    read -r -p "    ${prompt} [${default}]: " reply
    echo "${reply:-$default}"
  else
    read -r -p "    ${prompt}: " reply
    echo "$reply"
  fi
}

looks_like_hostname() {
  [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$ ]]
}

# Uncomments/sets a KEY=VALUE line in ENV_FILE, or appends it if absent.
set_env_var() {
  local key="$1" value="$2" tmp
  if [ ! -f "$ENV_FILE" ]; then
    warn "${ENV_FILE} doesn't exist yet -- skipping ${key} (run 'curodav-ctl install' first)."
    return 1
  fi
  local escaped
  escaped="$(printf '%s' "$value" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
  tmp="$(mktemp)"
  # ENVIRON (not awk -v) so backslashes in $value aren't re-interpreted.
  # Only the first matching KEY= line is rewritten; any further duplicate is dropped.
  SETENV_KEY="$key" SETENV_VALUE="$escaped" awk '
    BEGIN { k = ENVIRON["SETENV_KEY"]; v = ENVIRON["SETENV_VALUE"]; found = 0 }
    {
      line = $0
      sub(/^#[ \t]*/, "", line)
      if (line ~ ("^" k "=")) {
        if (!found) { print k "=\"" v "\""; found = 1 }
      } else {
        print $0
      }
    }
    END { if (!found) print k "=\"" v "\"" }
  ' "$ENV_FILE" > "$tmp"
  chown --reference="$ENV_FILE" "$tmp"
  chmod --reference="$ENV_FILE" "$tmp"
  mv "$tmp" "$ENV_FILE"
}

# Non-fatal reachability checks (loopback, local nginx, public hostname).
# No-ops quietly on a host that never set up DAV.
radicale_reachability_check() {
  if ! systemctl list-unit-files 2>/dev/null | grep -q '^radicale\.service'; then
    return 0
  fi

  log "Checking Radicale reachability..."
  local loopback_code
  loopback_code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "http://127.0.0.1:${RADICALE_PORT}/" 2>/dev/null || echo "000")"
  if [ "$loopback_code" != "000" ]; then
    log "  radicale loopback (127.0.0.1:${RADICALE_PORT}): HTTP ${loopback_code} -- reachable."
  else
    warn "  radicale loopback (127.0.0.1:${RADICALE_PORT}): no response -- check 'systemctl status radicale' / 'journalctl -u radicale -e'."
  fi

  if systemctl list-unit-files 2>/dev/null | grep -q '^nginx\.service'; then
    local nginx_code
    nginx_code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "http://127.0.0.1:8080/radicale/" 2>/dev/null || echo "000")"
    if [ "$nginx_code" != "000" ]; then
      log "  nginx path-route (127.0.0.1:8080/radicale/): HTTP ${nginx_code} -- reachable."
    else
      warn "  nginx path-route (127.0.0.1:8080/radicale/): no response -- check 'systemctl status nginx' / 'nginx -t'."
    fi
  else
    warn "  nginx isn't installed -- Radicale has no path to the public hostname yet (run 'curodav-ctl install --dav')."
  fi

  if [ ! -f "$DEPLOY_ENV_FILE" ]; then
    warn "  no ${DEPLOY_ENV_FILE} -- skipping public reachability check (run 'curodav-ctl install --dav')."
    return 0
  fi
  local domain_app
  domain_app="$(grep -E '^DOMAIN_APP=' "$DEPLOY_ENV_FILE" | tail -n1 | cut -d= -f2-)"
  if [ -z "$domain_app" ]; then
    warn "  ${DEPLOY_ENV_FILE} has no DOMAIN_APP set -- skipping public reachability check."
    return 0
  fi
  local public_code
  public_code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "https://${domain_app}/radicale/" 2>/dev/null || echo "000")"
  case "$public_code" in
    200|301|302|401|403)
      log "  public (https://${domain_app}/radicale/): HTTP ${public_code} -- reachable through the tunnel." ;;
    000)
      warn "  public (https://${domain_app}/radicale/): no response at all -- check 'systemctl status cloudflared' / 'journalctl -u cloudflared -e' and DNS." ;;
    *)
      warn "  public (https://${domain_app}/radicale/): unexpected HTTP ${public_code} -- check nginx's /radicale/ block and Cloudflare's WAF/Bot Fight Mode settings." ;;
  esac
}

# Non-fatal env-file consistency check (direct feedback: "the way these env
# variables are set... opaque and hard to set or verify"). CC_RADICALE_URL
# (what the app actually syncs against, always loopback) and
# CC_RADICALE_PUBLIC_URL (display-only, Published Lists' subscribe link)
# are supposed to name the SAME Radicale user under different hosts --
# nothing enforces that at write time if either was hand-edited after the
# fact (e.g. RADICALE_USER rotated via a fresh 'install --dav' run without
# also fixing a manually-edited CC_RADICALE_URL). No-ops quietly when
# ENV_FILE doesn't exist yet or doesn't have both vars set -- there's
# nothing to compare.
radicale_env_consistency_check() {
  if [ ! -f "$ENV_FILE" ]; then
    return 0
  fi
  local url public_url url_user public_user
  url="$(grep -E '^CC_RADICALE_URL=' "$ENV_FILE" | tail -n1 | cut -d= -f2- | tr -d '"')"
  public_url="$(grep -E '^CC_RADICALE_PUBLIC_URL=' "$ENV_FILE" | tail -n1 | cut -d= -f2- | tr -d '"')"
  if [ -z "$url" ] || [ -z "$public_url" ]; then
    return 0
  fi
  url_user="$(echo "${url%/}" | awk -F/ '{print $NF}')"
  public_user="$(echo "${public_url%/}" | awk -F/ '{print $NF}')"
  if [ -n "$url_user" ] && [ -n "$public_user" ] && [ "$url_user" != "$public_user" ]; then
    warn "  ${ENV_FILE}: CC_RADICALE_URL's user (\"${url_user}\") and CC_RADICALE_PUBLIC_URL's (\"${public_user}\") don't match -- one of them is stale."
  else
    log "  ${ENV_FILE}: CC_RADICALE_URL and CC_RADICALE_PUBLIC_URL agree on the Radicale user (\"${url_user}\")."
  fi
}

detect_repo_url_from_self() {
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if git -C "$script_dir" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "$script_dir" remote get-url origin 2>/dev/null || true
  fi
}

resolve_repo_url_for_install() {
  if [ -n "${CURODAV_REPO_URL:-}" ]; then
    echo "$CURODAV_REPO_URL"
    return
  fi
  local detected
  detected="$(detect_repo_url_from_self)"
  if [ -n "$detected" ]; then
    echo "$detected"
    return
  fi
  err "Could not determine the app repo's URL."
  err "Run this from inside a git clone of the app repo, e.g.:"
  err "    git clone <repo-url> /tmp/bootstrap && sudo /tmp/bootstrap/scripts/curodav-ctl install"
  err "or set it explicitly:"
  err "    sudo CURODAV_REPO_URL=<repo-url> -E curodav-ctl install"
  exit 1
}

load_repo_url() {
  if [ -n "${CURODAV_REPO_URL:-}" ]; then
    echo "$CURODAV_REPO_URL"
    return
  fi
  if [ -f "$REPO_URL_FILE" ]; then
    cat "$REPO_URL_FILE"
    return
  fi
  err "${REPO_URL_FILE} not found -- has 'install' been run yet?"
  exit 1
}

ensure_user() {
  if ! id -u "$APP_USER" >/dev/null 2>&1; then
    log "Creating system user '$APP_USER'..."
    useradd --system --home-dir "$SHARED_DIR" --shell /usr/sbin/nologin "$APP_USER"
  fi
}

ensure_dirs() {
  log "Creating directory layout under ${BASE_DIR}..."
  install -d -o "$APP_USER" -g "$APP_USER" "$RELEASES_DIR" "$SHARED_DIR" \
    "$DATA_DIR" "$DATA_DIR/backups"
}

ensure_uv() {
  if ! command -v uv >/dev/null 2>&1; then
    log "Installing uv (system-wide, ${UV_INSTALL_DIR})..."
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="$UV_INSTALL_DIR" sh
  fi
}

self_install() {
  local self_path
  self_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  if [ "$(readlink -f "$self_path")" != "$(readlink -f "$INSTALLED_CTL" 2>/dev/null || echo "")" ]; then
    log "Installing this script to ${INSTALLED_CTL}..."
    install -m 0755 "$self_path" "$INSTALLED_CTL"
  fi
}

write_env_template() {
  if [ -f "$ENV_FILE" ]; then
    warn ".env already exists at ${ENV_FILE}, leaving it untouched."
    return
  fi
  log "Generating ${ENV_FILE} with a random auth-session secret..."
  local secret
  secret="$(openssl rand -hex 32)"
  cat > "$ENV_FILE" <<EOF
# curodav configuration -- generated by curodav-ctl install on $(date -Is)

CC_DB_PATH=${DATA_DIR}/cache.sqlite
CC_BACKUP_DIR=${DATA_DIR}/backups

CC_SYNC_INTERVAL=60

# Forces the first-run /setup flow until an account exists. Do not unset
# on a deploy reachable off localhost.
CC_DEPLOY_MODE=production

CC_AUTH_SECRET=${secret}

# Uncomment to pre-provision the single-user login instead of using /setup:
# CC_AUTH_USERNAME=you
# CC_AUTH_PASSWORD=change-me

# Optional CalDAV/CardDAV sync against a Radicale server. Unset = app runs
# standalone. CC_RADICALE_URL must stay LOOPBACK even on a public deploy.
# CC_RADICALE_URL=http://127.0.0.1:5232/curodav/
# CC_RADICALE_USER=curodav
# CC_RADICALE_PASSWORD=
# CC_CALENDAR_COLLECTION=calendar
# CC_TASKS_COLLECTION=tasks
# CC_CONTACTS_COLLECTION=contacts

# Public-facing Radicale URL, for display only (Published Lists' subscribe
# links). Set automatically by 'curodav-ctl install --dav'.
# CC_RADICALE_PUBLIC_URL=https://app.example.com/radicale/curodav/
EOF
  chown root:"$APP_USER" "$ENV_FILE"
  chmod 0660 "$ENV_FILE"
}

write_unit() {
  local repo_url
  repo_url="$(load_repo_url)"
  log "Writing systemd unit to ${UNIT_FILE}..."
  cat > "$UNIT_FILE" <<EOF
# curodav -- managed by curodav-ctl. Re-generated on every 'install';
# use a drop-in at ${UNIT_FILE}.d/ for local overrides.
[Unit]
Description=Command Center Web (curodav) -- personal organizer PWA
Documentation=${repo_url}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${CURRENT_LINK}
EnvironmentFile=${ENV_FILE}
Environment=CC_ENV_FILE=${ENV_FILE}
ExecStart=${CURRENT_LINK}/.venv/bin/python -m uvicorn src.main:app --host 0.0.0.0 --port ${TARGET_PORT} --proxy-headers --app-dir ${CURRENT_LINK}/webapp
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=${SHARED_DIR}

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
}

health_check() {
  local url="http://127.0.0.1:${TARGET_PORT}${HEALTH_PATH}"
  # 90s budget (45 attempts x 2s): main.py's lifespan runs a synchronous
  # full_refresh() before uvicorn binds the port at all (one CalDAV/
  # CardDAV round trip per published-list member, sequential -- see
  # sync.py/published_lists.py) -- until that finishes, every attempt
  # here gets connection-refused, not a slow response. The old 10s
  # budget (10 x 1s) was tuned for an empty/small dataset and started
  # false-positive rolling back healthy deploys once published lists grew
  # (confirmed 2026-09-13: rolled back a release health-checking was still
  # mid-startup-sync). This is a timing workaround, not a fix -- the real
  # fix is moving full_refresh off uvicorn's startup critical path (see
  # STATE.md).
  local attempts=45
  for i in $(seq 1 "$attempts"); do
    if curl -fsS -o /dev/null "$url"; then
      return 0
    fi
    sleep 2
  done
  return 1
}

atomic_symlink() {
  local target="$1" link="$2" tmp
  tmp="$(mktemp -u "${link}.XXXXXX")"
  ln -s "$target" "$tmp"
  mv -T "$tmp" "$link"
}

prune_releases() {
  log "Pruning old releases (keeping last ${KEEP_RELEASES})..."
  # shellcheck disable=SC2012
  ls -1dt "${RELEASES_DIR}"/release_* 2>/dev/null | tail -n +$((KEEP_RELEASES + 1)) | \
    while read -r old; do
      # Never delete whatever current/previous still point at.
      if [ "$(readlink -f "$CURRENT_LINK" 2>/dev/null)" = "$(readlink -f "$old")" ]; then continue; fi
      if [ "$(readlink -f "$PREVIOUS_LINK" 2>/dev/null)" = "$(readlink -f "$old")" ]; then continue; fi
      rm -rf "$old"
    done
}

collect_deploy_env() {
  local existing_domain_app="" existing_tunnel_name="curodav" existing_radicale_user="curodav"
  if [ -f "$DEPLOY_ENV_FILE" ]; then
    # shellcheck disable=SC1090
    source "$DEPLOY_ENV_FILE"
    existing_domain_app="${DOMAIN_APP:-}"
    existing_tunnel_name="${TUNNEL_NAME:-curodav}"
    existing_radicale_user="${RADICALE_USER:-curodav}"
  fi

  # 2026-09-18 (direct request: "not make to input the same variables 20
  # times") -- every earlier run already persisted these three to
  # DEPLOY_ENV_FILE and offered them back as defaults, but still forced
  # pressing Enter through all three on every single re-run of
  # 'install --dav'. Skip the prompts entirely once they're already set;
  # --reconfigure is the explicit opt-in to change them.
  if [ "${RECONFIGURE:-0}" -ne 1 ] && [ -n "$existing_domain_app" ]; then
    log "Reusing existing DAV config from ${DEPLOY_ENV_FILE} (DOMAIN_APP=${existing_domain_app}) -- pass --reconfigure to change it."
    DOMAIN_APP="$existing_domain_app"
    TUNNEL_NAME="$existing_tunnel_name"
    RADICALE_USER="$existing_radicale_user"
    return
  fi

  log "Public CalDAV/CardDAV access needs a few values (press Enter to keep a bracketed default)."
  local domain_app tunnel_name radicale_user
  while true; do
    domain_app="$(prompt_default "Public hostname (DOMAIN_APP) -- Radicale is reached at this same hostname's /radicale/ path, not a second subdomain" "$existing_domain_app")"
    looks_like_hostname "$domain_app" && break
    warn "Doesn't look like a hostname (e.g. app.example.com) -- try again."
  done
  # Irrelevant to a manual (non-Cloudflare) proxy setup -- skip asking for a
  # value that install-cloudflared.sh will never be called with.
  if [ "${PROXY_MODE:-cloudflare}" = "cloudflare" ]; then
    tunnel_name="$(prompt_default "Cloudflare Tunnel name" "$existing_tunnel_name")"
  else
    tunnel_name="$existing_tunnel_name"
  fi
  radicale_user="$(prompt_default "Radicale username" "$existing_radicale_user")"

  cat > "$DEPLOY_ENV_FILE" <<EOF
# Generated by 'curodav-ctl install --dav' on $(date -Is).
DOMAIN_APP=${domain_app}
TUNNEL_NAME=${tunnel_name}
RADICALE_USER=${radicale_user}
EOF
  chmod 0600 "$DEPLOY_ENV_FILE"
  log "Wrote ${DEPLOY_ENV_FILE}."
}

collect_radicale_password() {
  local pw pw_confirm
  while true; do
    read -r -s -p "    Set a Radicale password: " pw; echo
    read -r -s -p "    Confirm: " pw_confirm; echo
    if [ -z "$pw" ]; then
      warn "Password can't be empty -- try again."
    elif [ "$pw" != "$pw_confirm" ]; then
      warn "Didn't match -- try again."
    else
      break
    fi
  done
  RADICALE_PASSWORD="$pw"
  RADICALE_PASSWORD_CONFIRM="$pw_confirm"
}

run_dav_setup() {
  require_root
  local release_dir deploy_src
  release_dir="$(readlink -f "$CURRENT_LINK" 2>/dev/null || true)"
  if [ -z "$release_dir" ] || [ ! -d "${release_dir}/deploy" ]; then
    err "No deployed release with a deploy/ directory found at ${CURRENT_LINK} -- run 'curodav-ctl install' or 'curodav-ctl update' first."
    exit 1
  fi
  deploy_src="${release_dir}/deploy"

  collect_deploy_env

  log "Locking down the firewall (ssh only)..."
  # If sshd isn't actually on port 22, firewall.sh refuses to proceed --
  # opening only 22 while sshd listens elsewhere would lock this host out
  # with no way back short of provider console access. Re-run as:
  #   sudo FIREWALL_SSH_PORT=<your-actual-ssh-port> curodav-ctl install --dav
  bash "${deploy_src}/firewall.sh"

  local radicale_user domain_app
  radicale_user="$(grep -E '^RADICALE_USER=' "$DEPLOY_ENV_FILE" | tail -n1 | cut -d= -f2-)"
  domain_app="$(grep -E '^DOMAIN_APP=' "$DEPLOY_ENV_FILE" | tail -n1 | cut -d= -f2-)"

  # 2026-09-18 (direct request: "not make to input the same variables 20
  # times") -- install-radicale.sh already leaves an existing user's
  # password untouched unless it's told --reset-password; this only asks
  # for a new one when there isn't one yet, or --reconfigure explicitly
  # asked to rotate it. Mirrors collect_deploy_env's own skip-if-already-set
  # behavior above.
  local radicale_password_flag=()
  RADICALE_PASSWORD=""
  RADICALE_PASSWORD_CONFIRM=""
  if [ "${RECONFIGURE:-0}" -eq 1 ] || ! grep -q "^${radicale_user}:" "$RADICALE_USERS_FILE" 2>/dev/null; then
    collect_radicale_password
    if [ "${RECONFIGURE:-0}" -eq 1 ]; then
      radicale_password_flag=(--reset-password)
    fi
  else
    log "Radicale user '${radicale_user}' already has a password set -- leaving it untouched (pass --reconfigure to rotate it)."
  fi

  log "Installing Radicale..."
  DEPLOY_ENV_FILE="$DEPLOY_ENV_FILE" RADICALE_PASSWORD="$RADICALE_PASSWORD" RADICALE_PASSWORD_CONFIRM="$RADICALE_PASSWORD_CONFIRM" \
    bash "${deploy_src}/radicale/install-radicale.sh" "${radicale_password_flag[@]}"

  # 2026-09-18 (direct request: "a clearer way to integrate cloudflare
  # tunnel or any other fix into that installer, because some users might
  # install it manually") -- nginx + Radicale are proxy-agnostic (nginx
  # only path-routes on loopback; whatever sits in front of it, Cloudflare
  # Tunnel or otherwise, just needs to reach 127.0.0.1:8080), so only the
  # Cloudflare-specific step is conditional. The rate-limit zone's IP
  # source has to follow suit -- $http_cf_connecting_ip only means anything
  # behind an actual Cloudflare Tunnel (see curodav-ratelimit.conf.template's
  # own comment); a manual proxy on the same host gets $remote_addr instead.
  local rate_limit_ip_source='$http_cf_connecting_ip'
  if [ "${PROXY_MODE:-cloudflare}" != "cloudflare" ]; then
    rate_limit_ip_source='$remote_addr'
  fi
  log "Installing the local nginx path-router (/radicale/* -> Radicale, everything else -> curodav)..."
  RATE_LIMIT_IP_SOURCE="$rate_limit_ip_source" bash "${deploy_src}/nginx/install-nginx.sh"

  if [ "${PROXY_MODE:-cloudflare}" = "cloudflare" ]; then
    log "Setting up the Cloudflare Tunnel (this will pause for a browser login the first time)..."
    DEPLOY_ENV_FILE="$DEPLOY_ENV_FILE" bash "${deploy_src}/cloudflared/install-cloudflared.sh"
  else
    log "--proxy=manual: skipping Cloudflare Tunnel setup."
    log "nginx is listening on 127.0.0.1:8080 -- point your own reverse proxy, tunnel,"
    log "or Caddy/other nginx at that address for both / and /radicale/, terminating"
    log "TLS at ${domain_app:-<your DOMAIN_APP>} yourself. See deploy/README.md's"
    log "\"Bringing your own reverse proxy\" section for the full walkthrough."
  fi

  if [ -f "$ENV_FILE" ]; then
    log "Wiring Radicale into ${ENV_FILE}..."
    set_env_var CC_RADICALE_URL "http://127.0.0.1:${RADICALE_PORT}/${radicale_user}/"
    set_env_var CC_RADICALE_USER "$radicale_user"
    if [ -n "$RADICALE_PASSWORD" ]; then
      set_env_var CC_RADICALE_PASSWORD "$RADICALE_PASSWORD"
    fi
    set_env_var CC_RADICALE_PUBLIC_URL "https://${domain_app}/radicale/${radicale_user}/"
    if systemctl list-unit-files 2>/dev/null | grep -q "^${APP_NAME}\.service"; then
      log "Restarting ${APP_NAME}.service to pick up Radicale config..."
      systemctl restart "${APP_NAME}.service"
    fi
  else
    warn "${ENV_FILE} doesn't exist yet -- once you run 'curodav-ctl install', add:"
    warn "    CC_RADICALE_URL=http://127.0.0.1:${RADICALE_PORT}/${radicale_user}/"
    warn "    CC_RADICALE_USER=${radicale_user}"
    warn "    CC_RADICALE_PASSWORD=<the password you just set>"
    warn "    CC_RADICALE_PUBLIC_URL=https://${domain_app}/radicale/${radicale_user}/"
  fi
  unset RADICALE_PASSWORD RADICALE_PASSWORD_CONFIRM

  radicale_reachability_check
  radicale_env_consistency_check
  log "DAV setup complete. DAVx5 account: https://${domain_app}/radicale/${radicale_user}/ (user: ${radicale_user})"
}

cmd_install() {
  require_root
  # Refresh /usr/local/bin's copy of this script even on the --dav-only
  # path, so PATH-based invocations pick up fixes without needing to be
  # run from a release checkout again.
  self_install

  if [ "${DAV_ONLY:-0}" -eq 1 ]; then
    run_dav_setup
    return
  fi

  ensure_user
  ensure_dirs

  if [ ! -f "$REPO_URL_FILE" ]; then
    local repo_url
    repo_url="$(resolve_repo_url_for_install)"
    log "Using repo URL: ${repo_url}"
    printf '%s\n' "$repo_url" > "$REPO_URL_FILE"
    chown "$APP_USER":"$APP_USER" "$REPO_URL_FILE"
    chmod 0644 "$REPO_URL_FILE"
  else
    warn "Repo URL already recorded at ${REPO_URL_FILE}, reusing it."
  fi

  ensure_uv
  write_env_template
  write_unit
  cmd_update
  systemctl enable --now "${APP_NAME}.service"
  log "Installed and started ${APP_NAME}.service."
  log "Edit ${ENV_FILE} then 'systemctl restart ${APP_NAME}' if you need to change config."

  local admin_user
  admin_user="$(prompt_default "Set an admin username now? Leave blank to use the web /setup flow instead" "")"
  if [ -n "$admin_user" ]; then
    local admin_pass admin_pass_confirm
    while true; do
      read -r -s -p "    Password for '${admin_user}': " admin_pass; echo
      read -r -s -p "    Confirm: " admin_pass_confirm; echo
      if [ -z "$admin_pass" ]; then
        warn "Password can't be empty -- try again."
      elif [ "$admin_pass" != "$admin_pass_confirm" ]; then
        warn "Didn't match -- try again."
      else
        break
      fi
    done
    set_env_var CC_AUTH_USERNAME "$admin_user"
    set_env_var CC_AUTH_PASSWORD "$admin_pass"
    unset admin_pass admin_pass_confirm
    systemctl restart "${APP_NAME}.service"
    log "Admin login set for '${admin_user}'."
  else
    log "Skipped -- visit /setup on first load to create the account instead."
  fi

  local setup_dav
  setup_dav="$(prompt_default "Set up public CalDAV/CardDAV access now (Radicale + Cloudflare Tunnel)? [y/N]" "N")"
  if [[ "$setup_dav" =~ ^[Yy]([Ee][Ss])?$ ]]; then
    run_dav_setup
  else
    log "Skipped. Run 'curodav-ctl install --dav' any time later to add it."
  fi
}

cmd_update() {
  require_root
  ensure_uv

  local repo_url
  repo_url="$(load_repo_url)"

  local tmp_clone
  tmp_clone="$(mktemp -d)"
  # Clears itself as its first action -- a RETURN trap isn't function-scoped
  # in bash, so left alone it would re-fire on every later function return
  # (e.g. cmd_install's own calls right after cmd_update finishes) against
  # this now-out-of-scope local variable, dying with "unbound variable"
  # under set -u.
  trap 'rm -rf "$tmp_clone"; trap - RETURN' RETURN

  log "Cloning ${repo_url} (${GIT_BRANCH})..."
  git clone --depth 1 --branch "$GIT_BRANCH" "$repo_url" "$tmp_clone"

  # Refresh /usr/local/bin's installed copy from THIS fresh clone, not via
  # self_install (which copies whatever's at ${BASH_SOURCE[0]} -- when
  # invoked as plain `curodav-ctl update`, that's already the installed
  # copy itself, a same-file no-op). Previously only `install` refreshed
  # /usr/local/bin, so a fix to this script (e.g. the health_check timing
  # fix, 2026-09-13) never took effect via `update` on an already-installed
  # host -- every future `update` kept re-running the stale pre-fix binary
  # forever, even though every new release's checkout had the fix. Done
  # before the health check below so THIS run also benefits if this
  # function is ever re-entered, though the primary effect is on the next
  # invocation of `curodav-ctl`.
  if [ -f "${tmp_clone}/scripts/curodav-ctl" ]; then
    install -m 0755 "${tmp_clone}/scripts/curodav-ctl" "$INSTALLED_CTL"
  fi

  local hash release_name release_dir
  hash="$(git -C "$tmp_clone" rev-parse --short HEAD)"
  release_name="release_$(date +%Y%m%d_%H%M%S)_${hash}"
  release_dir="${RELEASES_DIR}/${release_name}"

  log "Building release ${release_name}..."
  rsync -a --exclude .git "$tmp_clone/" "$release_dir/"
  chown -R "$APP_USER":"$APP_USER" "$release_dir"

  su -s /bin/bash "$APP_USER" -c "
    set -euo pipefail
    export HOME='${SHARED_DIR}'
    cd '${release_dir}/webapp'
    uv sync --frozen --no-dev
  "

  if [ ! -x "${release_dir}/.venv/bin/python" ]; then
    err "Build did not produce ${release_dir}/.venv/bin/python -- aborting, nothing swapped."
    rm -rf "$release_dir"
    exit 1
  fi

  local old_current=""
  if [ -L "$CURRENT_LINK" ]; then
    old_current="$(readlink -f "$CURRENT_LINK")"
  fi

  log "Swapping current -> ${release_name}..."
  atomic_symlink "$release_dir" "$CURRENT_LINK"

  log "Restarting ${APP_NAME}.service..."
  systemctl restart "${APP_NAME}.service"

  log "Health-checking http://127.0.0.1:${TARGET_PORT}${HEALTH_PATH} ..."
  if health_check; then
    log "Health check passed."
    if [ -n "$old_current" ] && [ "$old_current" != "$release_dir" ]; then
      atomic_symlink "$old_current" "$PREVIOUS_LINK"
    fi
    prune_releases
    log "Deploy complete: ${release_name}"
    radicale_reachability_check
    radicale_env_consistency_check
  else
    err "Health check FAILED. Rolling back..."
    if [ -n "$old_current" ]; then
      atomic_symlink "$old_current" "$CURRENT_LINK"
      systemctl restart "${APP_NAME}.service"
      err "Rolled back to previous release ($(basename "$old_current"))."
    else
      err "No previous release to roll back to (this was the first deploy)."
    fi
    rm -rf "$release_dir"
    exit 1
  fi
}

cmd_revert() {
  require_root
  # Local equivalent of .github/workflows/rollback.yml's remote SSH+symlink
  # swap (2026-09-18, direct request: "have a revert command") -- same
  # one-way semantic documented there: this points current at whatever
  # previous currently resolves to, it doesn't maintain a redo stack, so a
  # second consecutive run just re-points current at the same release
  # again, not "undo the revert." Adds one thing the blunt remote version
  # doesn't have: a real health check afterward, using the same
  # health_check() 'update' already relies on.
  if [ ! -L "$PREVIOUS_LINK" ]; then
    err "No ${PREVIOUS_LINK} symlink -- nothing to revert to (only one deploy has happened, or 'remove' was already run)."
    exit 1
  fi
  local target
  target="$(readlink -f "$PREVIOUS_LINK")"
  if [ ! -d "$target" ]; then
    err "${PREVIOUS_LINK} points at ${target}, which no longer exists -- nothing to revert to."
    exit 1
  fi
  log "Reverting current -> $(basename "$target")..."
  atomic_symlink "$target" "$CURRENT_LINK"
  systemctl restart "${APP_NAME}.service"
  log "Health-checking http://127.0.0.1:${TARGET_PORT}${HEALTH_PATH} ..."
  if health_check; then
    log "Reverted to $(basename "$target") and healthy."
  else
    err "Reverted, but the health check still failed -- check 'journalctl -u ${APP_NAME} -e'."
    exit 1
  fi
}

cmd_remove() {
  require_root
  warn "This will stop ${APP_NAME}, delete its systemd unit, remove the"
  warn "'${APP_USER}' system user, and wipe ${BASE_DIR} (all releases + data)."
  read -r -p "Type 'yes' to confirm: " confirm
  if [ "$confirm" != "yes" ]; then
    err "Aborted."
    exit 1
  fi

  systemctl stop "${APP_NAME}.service" 2>/dev/null || true
  systemctl disable "${APP_NAME}.service" 2>/dev/null || true
  rm -f "$UNIT_FILE"
  systemctl daemon-reload

  if id -u "$APP_USER" >/dev/null 2>&1; then
    userdel "$APP_USER" 2>/dev/null || true
  fi

  rm -rf "$BASE_DIR"
  log "Removed ${APP_NAME}. ${INSTALLED_CTL} was left in place -- 'rm ${INSTALLED_CTL}' if you want it gone too."
}

case "${1:-}" in
  install)
    DAV_ONLY=0
    RECONFIGURE=0
    PROXY_MODE="cloudflare"
    if [ "${2:-}" = "--dav" ]; then
      DAV_ONLY=1
      for arg in "${@:3}"; do
        case "$arg" in
          --reconfigure)   RECONFIGURE=1 ;;
          --proxy=cloudflare) PROXY_MODE="cloudflare" ;;
          --proxy=manual)  PROXY_MODE="manual" ;;
          *)
            echo "Usage: curodav-ctl install --dav [--proxy=cloudflare|manual] [--reconfigure]" >&2
            exit 2
            ;;
        esac
      done
    elif [ -n "${2:-}" ]; then
      echo "Usage: curodav-ctl install [--dav [--proxy=cloudflare|manual] [--reconfigure]]" >&2
      exit 2
    fi
    cmd_install
    ;;
  update)  cmd_update ;;
  revert)  cmd_revert ;;
  status)
    # No require_root -- every check here (curl against loopback/nginx/
    # public hostname, grep-ing ENV_FILE) is a plain read, and the whole
    # point is a fast "is this actually working right now" answer without
    # needing sudo or triggering a deploy. Direct feedback: "I don't know
    # if [the env vars] are set correctly" -- this is the standalone
    # answer to that, previously only available as a side effect of
    # 'install --dav' or 'update'.
    radicale_reachability_check
    radicale_env_consistency_check
    ;;
  remove)  cmd_remove ;;
  *)
    echo "Usage: curodav-ctl {install [--dav [--proxy=cloudflare|manual] [--reconfigure]]|update|status|revert|remove}" >&2
    exit 2
    ;;
esac
