#!/usr/bin/env bash
# curodav-ctl -- install / update / remove Command Center Web (curodav)
# on a Debian 12 LXC, no Docker, systemd-managed, release/symlink deploys.
#
# This script lives IN the app repo (scripts/curodav-ctl), not in a
# separate infra repo, and is self-aware of where it came from -- it does
# not hardcode REPO_URL. See "Repo URL detection" below.
#
# Bootstrap (fresh LXC, first install):
#   git clone https://github.com/istorie-petru/curodav.git /tmp/bootstrap
#   sudo /tmp/bootstrap/scripts/curodav-ctl install
#   rm -rf /tmp/bootstrap   # install already copied itself to /usr/local/bin
#
# Day to day, once installed:
#   sudo curodav-ctl update       # deploy latest main, atomic swap, auto-rollback
#   sudo curodav-ctl install --dav  # add/reconfigure public CalDAV/CardDAV
#                                    # access (Radicale + Cloudflare Tunnel) --
#                                    # interactive, safe to re-run any time,
#                                    # touches nothing app-related. See
#                                    # deploy/README.md for what it does.
#   sudo curodav-ctl remove       # tear down (destructive, confirms)
#
# 'install' (no flag) also offers, at the end, to set an admin login up
# front and to chain straight into 'install --dav' -- both optional, both
# skippable. 'update' always re-checks Radicale reachability (loopback +,
# if DAV was ever set up, the public hostname) but never installs/prompts
# anything -- it's the same command GitHub Actions runs unattended over SSH.
#
# Layout:
#   /srv/curodav/releases/release_<timestamp>_<hash>/   one per deploy, uv-built
#   /srv/curodav/current -> releases/<latest>            atomically swapped
#   /srv/curodav/previous -> releases/<prior>             swap target for rollback
#   /srv/curodav/shared/.env                              persistent config (EnvironmentFile)
#   /srv/curodav/shared/repo_url                          persisted origin URL (see below)
#   /srv/curodav/shared/deploy.env                        persisted DAV domains/tunnel name (install --dav)
#   /srv/curodav/shared/data/                             SQLite cache + backups (survives swaps)
#
# Repo URL detection:
#   `install` needs a repo to clone. It never hardcodes one; instead:
#     1. $CURODAV_REPO_URL env var, if set (explicit override -- also how
#        you'd point this at a fork, or run it from a separate infra repo
#        per the "Option B" layout instead of the in-repo "Option A" this
#        file assumes).
#     2. Otherwise, `git remote get-url origin` from wherever THIS script
#        currently sits on disk -- which is why the bootstrap flow above
#        clones the app repo to /tmp/bootstrap first and runs the script
#        from inside that clone, rather than curl-ing just the raw file.
#   Whichever URL wins gets written to shared/repo_url so `update` and
#   `remove` (run later, against the copy at /usr/local/bin, which has no
#   git context of its own) know where to clone from without re-detecting.
set -euo pipefail

# --- manifest-derived constants (deployment_manifest for curodav) ----------
APP_NAME="curodav"
APP_USER="curodav"
GIT_BRANCH="main"
TARGET_PORT=8000
HEALTH_PATH="/"
KEEP_RELEASES=5
UV_INSTALL_DIR="/usr/local/bin"
INSTALLED_CTL="/usr/local/bin/${APP_NAME}-ctl"

BASE_DIR="/srv/${APP_NAME}"
RELEASES_DIR="${BASE_DIR}/releases"
SHARED_DIR="${BASE_DIR}/shared"
DATA_DIR="${SHARED_DIR}/data"
CURRENT_LINK="${BASE_DIR}/current"
PREVIOUS_LINK="${BASE_DIR}/previous"
ENV_FILE="${SHARED_DIR}/.env"
REPO_URL_FILE="${SHARED_DIR}/repo_url"
UNIT_FILE="/etc/systemd/system/${APP_NAME}.service"

# --- DAV (Radicale + Cloudflare Tunnel) constants ---------------------------
# See deploy/README.md for the full picture. deploy/deploy.env is gitignored
# and would otherwise only ever exist inside whichever release directory it
# was created in -- disposable on every 'update' clone, same problem
# REPO_URL_FILE solves for the repo URL. DEPLOY_ENV_FILE is the persisted,
# outside-of-any-release copy; deploy/*.sh accept a DEPLOY_ENV_FILE env var
# override (see those scripts) so curodav-ctl can point them here instead of
# the release-local deploy/deploy.env.
DEPLOY_ENV_FILE="${SHARED_DIR}/deploy.env"
RADICALE_PORT=5232

# --- colored logging ---------------------------------------------------------
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
log()  { echo -e "${GREEN}==>${NC} $*"; }
warn() { echo -e "${YELLOW}==>${NC} $*"; }
err()  { echo -e "${RED}==>${NC} $*" >&2; }

require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    err "curodav-ctl must run as root (sudo)."
    exit 1
  fi
}

# --- interactive prompt helpers ----------------------------------------------
prompt_default() {
  # $1 = prompt text, $2 = default (may be empty, meaning no default -- the
  # prompt keeps re-asking on an empty reply only if the caller checks for
  # that itself; this just echoes back whatever was typed or the default).
  local prompt="$1" default="$2" reply
  if [ -n "$default" ]; then
    read -r -p "    ${prompt} [${default}]: " reply
    echo "${reply:-$default}"
  else
    read -r -p "    ${prompt}: " reply
    echo "$reply"
  fi
}

looks_like_hostname() {
  [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$ ]]
}

# --- shared/.env patcher ------------------------------------------------------
# Uncomments and sets a KEY=VALUE line in ENV_FILE (matching write_env_template's
# own format -- see that function's comments), or appends it if the key isn't
# present in the template at all. Used to wire CC_RADICALE_*/CC_AUTH_* in
# without requiring a manual nano + restart, mirroring what
# webapp/src/env_file.py already does for the running app's own Settings page,
# but from this script (root, pre-process-start) instead.
set_env_var() {
  local key="$1" value="$2" tmp
  if [ ! -f "$ENV_FILE" ]; then
    warn "${ENV_FILE} doesn't exist yet -- skipping ${key} (run 'curodav-ctl install' first)."
    return 1
  fi
  # Escape backslash then double-quote, in that order, matching
  # env_file.py's own escaping convention for this file format.
  local escaped
  escaped="$(printf '%s' "$value" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
  tmp="$(mktemp)"
  # ENVIRON, not -v: awk's -v re-interprets backslash escape sequences in
  # the assigned string (a real gotcha -- a password containing '\' would
  # get silently mangled), whereas ENVIRON just reads the process
  # environment verbatim, no re-interpretation.
  # Only the FIRST matching line is replaced; any further line matching the
  # same key (e.g. a stray leftover commented-out duplicate alongside a
  # live one, from a hand-edit) is dropped rather than also being
  # overwritten -- collapses to exactly one line per key instead of
  # multiplying the new value across every match (a real bug caught while
  # testing this: a file with both a live and a commented CC_RADICALE_URL
  # line used to come out with TWO live CC_RADICALE_URL="..." lines after
  # one set_env_var call).
  SETENV_KEY="$key" SETENV_VALUE="$escaped" awk '
    BEGIN { k = ENVIRON["SETENV_KEY"]; v = ENVIRON["SETENV_VALUE"]; found = 0 }
    {
      line = $0
      sub(/^#[ \t]*/, "", line)
      if (line ~ ("^" k "=")) {
        if (!found) {
          print k "=\"" v "\""
          found = 1
        }
        # else: drop this duplicate line entirely.
      } else {
        print $0
      }
    }
    END { if (!found) print k "=\"" v "\"" }
  ' "$ENV_FILE" > "$tmp"
  chown --reference="$ENV_FILE" "$tmp"
  chmod --reference="$ENV_FILE" "$tmp"
  mv "$tmp" "$ENV_FILE"
}

# --- Radicale reachability -----------------------------------------------------
# Three independent tiers, all non-fatal (warn, never exit non-zero) --
# Radicale/nginx/the tunnel are separate services curodav-ctl doesn't
# deploy as part of the app itself, so a problem here shouldn't roll back
# or fail an otherwise-successful app install/update. Called from both
# cmd_install (after run_dav_setup) and cmd_update (after every successful
# deploy), and safe to call unconditionally -- it no-ops quietly on a host
# that never opted into DAV at all. Radicale is reached at DOMAIN_APP/radicale/,
# a PATH under the app's own single hostname (see deploy/README.md) -- NOT a
# second subdomain/second tunnel ingress rule.
radicale_reachability_check() {
  if ! systemctl list-unit-files 2>/dev/null | grep -q '^radicale\.service'; then
    return 0
  fi

  log "Checking Radicale reachability..."
  local loopback_code
  loopback_code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "http://127.0.0.1:${RADICALE_PORT}/" 2>/dev/null || echo "000")"
  if [ "$loopback_code" != "000" ]; then
    log "  radicale loopback (127.0.0.1:${RADICALE_PORT}): HTTP ${loopback_code} -- reachable."
  else
    warn "  radicale loopback (127.0.0.1:${RADICALE_PORT}): no response -- check 'systemctl status radicale' / 'journalctl -u radicale -e'."
  fi

  if systemctl list-unit-files 2>/dev/null | grep -q '^nginx\.service'; then
    local nginx_code
    nginx_code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "http://127.0.0.1:8080/radicale/" 2>/dev/null || echo "000")"
    if [ "$nginx_code" != "000" ]; then
      log "  nginx path-route (127.0.0.1:8080/radicale/): HTTP ${nginx_code} -- reachable."
    else
      warn "  nginx path-route (127.0.0.1:8080/radicale/): no response -- check 'systemctl status nginx' / 'nginx -t'."
    fi
  else
    warn "  nginx isn't installed -- Radicale has no path to the public hostname yet (run 'curodav-ctl install --dav', which installs it as part of the DAV setup)."
  fi

  if [ ! -f "$DEPLOY_ENV_FILE" ]; then
    warn "  no ${DEPLOY_ENV_FILE} -- skipping public reachability check (run 'curodav-ctl install --dav' to set up public DAV access)."
    return 0
  fi
  local domain_app
  domain_app="$(grep -E '^DOMAIN_APP=' "$DEPLOY_ENV_FILE" | tail -n1 | cut -d= -f2-)"
  if [ -z "$domain_app" ]; then
    warn "  ${DEPLOY_ENV_FILE} has no DOMAIN_APP set -- skipping public reachability check."
    return 0
  fi
  local public_code
  public_code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "https://${domain_app}/radicale/" 2>/dev/null || echo "000")"
  case "$public_code" in
    200|401|403)
      log "  public (https://${domain_app}/radicale/): HTTP ${public_code} -- reachable through the tunnel." ;;
    000)
      warn "  public (https://${domain_app}/radicale/): no response at all -- check 'systemctl status cloudflared' / 'journalctl -u cloudflared -e' and DNS for that hostname." ;;
    *)
      warn "  public (https://${domain_app}/radicale/): unexpected HTTP ${public_code} -- check nginx's /radicale/ location block and the Cloudflare zone's Security settings (WAF/Bot Fight Mode occasionally flag PROPFIND/REPORT requests)." ;;
  esac
}

# --- repo URL: detect once (install), persist, load thereafter -------------
detect_repo_url_from_self() {
  # Works only when this script is still sitting inside a git working tree
  # (the bootstrap clone at /tmp/bootstrap) -- not once it's a bare copy
  # at /usr/local/bin, which is the whole reason install() persists it.
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if git -C "$script_dir" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "$script_dir" remote get-url origin 2>/dev/null || true
  fi
}

resolve_repo_url_for_install() {
  if [ -n "${CURODAV_REPO_URL:-}" ]; then
    echo "$CURODAV_REPO_URL"
    return
  fi
  local detected
  detected="$(detect_repo_url_from_self)"
  if [ -n "$detected" ]; then
    echo "$detected"
    return
  fi
  err "Could not determine the app repo's URL."
  err "Run this from inside a git clone of the app repo, e.g.:"
  err "    git clone <repo-url> /tmp/bootstrap && sudo /tmp/bootstrap/scripts/curodav-ctl install"
  err "or set it explicitly:"
  err "    sudo CURODAV_REPO_URL=<repo-url> -E curodav-ctl install"
  exit 1
}

load_repo_url() {
  if [ -n "${CURODAV_REPO_URL:-}" ]; then
    echo "$CURODAV_REPO_URL"
    return
  fi
  if [ -f "$REPO_URL_FILE" ]; then
    cat "$REPO_URL_FILE"
    return
  fi
  err "${REPO_URL_FILE} not found -- has 'install' been run yet?"
  exit 1
}

# --- shared helpers -----------------------------------------------------------
ensure_user() {
  if ! id -u "$APP_USER" >/dev/null 2>&1; then
    log "Creating system user '$APP_USER'..."
    useradd --system --home-dir "$SHARED_DIR" --shell /usr/sbin/nologin "$APP_USER"
  fi
}

ensure_dirs() {
  log "Creating directory layout under ${BASE_DIR}..."
  install -d -o "$APP_USER" -g "$APP_USER" "$RELEASES_DIR" "$SHARED_DIR" \
    "$DATA_DIR" "$DATA_DIR/backups"
}

ensure_uv() {
  if ! command -v uv >/dev/null 2>&1; then
    log "Installing uv (system-wide, ${UV_INSTALL_DIR})..."
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="$UV_INSTALL_DIR" sh
  fi
}

self_install() {
  # Copies whatever script is currently running to /usr/local/bin, so
  # `update`/`remove` (and GitHub Actions' `curodav-ctl update` over SSH)
  # work without the bootstrap clone sticking around. `install` (a temp
  # file + rename) is safe to run even when overwriting the copy of this
  # same script currently executing -- the running process keeps reading
  # from the old inode until it exits.
  local self_path
  self_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  if [ "$(readlink -f "$self_path")" != "$(readlink -f "$INSTALLED_CTL" 2>/dev/null || echo "")" ]; then
    log "Installing this script to ${INSTALLED_CTL}..."
    install -m 0755 "$self_path" "$INSTALLED_CTL"
  fi
}

write_env_template() {
  if [ -f "$ENV_FILE" ]; then
    warn ".env already exists at ${ENV_FILE}, leaving it untouched."
    return
  fi
  log "Generating ${ENV_FILE} with a random auth-session secret..."
  local secret
  secret="$(openssl rand -hex 32)"
  cat > "$ENV_FILE" <<EOF
# curodav configuration -- generated by curodav-ctl install on $(date -Is)
# This file is EnvironmentFile for the systemd unit. It lives in shared/,
# outside any release directory, so it survives every 'update' swap.

# SQLite cache + data-health backups. Must stay in shared/, not inside a
# release directory, or every deploy would start from an empty database.
CC_DB_PATH=${DATA_DIR}/cache.sqlite
CC_BACKUP_DIR=${DATA_DIR}/backups

# Background sync interval (seconds).
CC_SYNC_INTERVAL=60

# Forces the first-run /setup flow until an account is created, instead of
# running fully open. Do not unset this on a deploy reachable off localhost.
CC_DEPLOY_MODE=production

# Auto-generated session-signing secret (rotate by editing this and
# restarting -- invalidates all existing sessions).
CC_AUTH_SECRET=${secret}

# Uncomment to pre-provision the single-user login instead of using /setup:
# CC_AUTH_USERNAME=you
# CC_AUTH_PASSWORD=change-me

# Optional CalDAV/CardDAV sync against a Radicale server. Unset = app runs
# standalone against its local SQLite cache only. CC_RADICALE_URL stays
# LOOPBACK even on a public deploy -- the app talks to Radicale directly
# over 127.0.0.1, never through nginx/the tunnel, for its own sync.
# CC_RADICALE_URL=http://127.0.0.1:5232/curodav/
# CC_RADICALE_USER=curodav
# CC_RADICALE_PASSWORD=
# CC_CALENDAR_COLLECTION=calendar
# CC_TASKS_COLLECTION=tasks
# CC_CONTACTS_COLLECTION=contacts

# Public-facing Radicale URL (through nginx + the Cloudflare Tunnel, at a
# /radicale/ path under this app's own hostname) -- used ONLY for display
# (e.g. Published Lists' subscribe links), never for the app's own sync.
# Set automatically by 'curodav-ctl install --dav'; safe to leave unset if
# you never expose Radicale publicly.
# CC_RADICALE_PUBLIC_URL=https://app.example.com/radicale/curodav/
EOF
  chown root:"$APP_USER" "$ENV_FILE"
  # 0660 (was 0640) -- group-writable, not just group-readable. The app
  # now has an in-app Settings > General editor for its own Radicale/
  # login env vars (a "Restart to apply" button included) that persists
  # changes by rewriting this file directly, running as $APP_USER (group
  # $APP_USER, per the chown above) -- it needs write access to its own
  # config, not just read. Still root-owned, still unreadable/unwritable
  # by anyone outside the curodav group.
  chmod 0660 "$ENV_FILE"
}

write_unit() {
  local repo_url
  repo_url="$(load_repo_url)"
  log "Writing systemd unit to ${UNIT_FILE}..."
  cat > "$UNIT_FILE" <<EOF
# curodav -- managed by curodav-ctl. Re-generated on every 'install';
# use a drop-in at ${UNIT_FILE}.d/ for local overrides instead of editing
# this file directly, or they will be silently overwritten.
[Unit]
Description=Command Center Web (curodav) -- personal organizer PWA
Documentation=${repo_url}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_USER}
# Required to literally be the 'current' symlink (release/rollback target),
# not a subdirectory of it -- see --app-dir below for why that's still
# enough for the app to import correctly.
WorkingDirectory=${CURRENT_LINK}
EnvironmentFile=${ENV_FILE}
# CC_ENV_FILE (distinct from EnvironmentFile= above): EnvironmentFile
# injects that file's KEY=VALUE pairs as env vars, but never tells the
# process where the file itself lives. Settings > General's env-var
# editor (webapp/src/env_file.py) needs the actual path to rewrite it,
# so it's handed in explicitly as one more ordinary env var, fixed at
# the same value ENV_FILE resolves to for this install.
Environment=CC_ENV_FILE=${ENV_FILE}
# The repo is a uv workspace (root pyproject.toml, webapp/ as member), so
# 'uv sync' from webapp/ puts the venv at the release root, not under
# webapp/. --app-dir tells uvicorn to add webapp/ to sys.path itself
# (equivalent to running with cwd=.../current/webapp) without requiring
# WorkingDirectory to point there.
ExecStart=${CURRENT_LINK}/.venv/bin/python -m uvicorn src.main:app --host 0.0.0.0 --port ${TARGET_PORT} --proxy-headers --app-dir ${CURRENT_LINK}/webapp
# Restart=always (was on-failure) -- Settings > General's "Restart app"
# button (routers/settings.py::restart_app) applies a saved env-var
# change by having the process exit cleanly (status 0) rather than
# shelling out to systemctl itself (no new privileges granted to
# $APP_USER for that). on-failure would never relaunch a clean exit;
# always does, which is exactly what that button relies on. A crash
# still restarts too, same as before -- always is a superset of
# on-failure, not a different recovery policy for the crash case.
Restart=always
RestartSec=3

# Hardening.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=${SHARED_DIR}

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
}

health_check() {
  local url="http://127.0.0.1:${TARGET_PORT}${HEALTH_PATH}"
  local attempts=10
  for i in $(seq 1 "$attempts"); do
    if curl -fsS -o /dev/null "$url"; then
      return 0
    fi
    sleep 1
  done
  return 1
}

atomic_symlink() {
  # $1 = target, $2 = link name. Uses a temp symlink + rename(2) via `mv -T`
  # so readers never observe a missing/half-written link.
  local target="$1" link="$2" tmp
  tmp="$(mktemp -u "${link}.XXXXXX")"
  ln -s "$target" "$tmp"
  mv -T "$tmp" "$link"
}

prune_releases() {
  log "Pruning old releases (keeping last ${KEEP_RELEASES})..."
  # shellcheck disable=SC2012
  ls -1dt "${RELEASES_DIR}"/release_* 2>/dev/null | tail -n +$((KEEP_RELEASES + 1)) | \
    while read -r old; do
      # Never delete whatever current/previous still point at.
      if [ "$(readlink -f "$CURRENT_LINK" 2>/dev/null)" = "$(readlink -f "$old")" ]; then continue; fi
      if [ "$(readlink -f "$PREVIOUS_LINK" 2>/dev/null)" = "$(readlink -f "$old")" ]; then continue; fi
      rm -rf "$old"
    done
}

# --- DAV setup (Radicale + local nginx path-router + Cloudflare Tunnel) -----
# ONE hostname (DOMAIN_APP) -- Radicale is reached at DOMAIN_APP/radicale/,
# a path split off locally by nginx (deploy/nginx/), never a second
# subdomain or a second tunnel ingress rule.
collect_deploy_env() {
  # Reuses whatever's already in DEPLOY_ENV_FILE as defaults -- re-running
  # 'install --dav' to fix a typo shouldn't mean re-typing everything.
  local existing_domain_app="" existing_tunnel_name="curodav" existing_radicale_user="curodav"
  if [ -f "$DEPLOY_ENV_FILE" ]; then
    # shellcheck disable=SC1090
    source "$DEPLOY_ENV_FILE"
    existing_domain_app="${DOMAIN_APP:-}"
    existing_tunnel_name="${TUNNEL_NAME:-curodav}"
    existing_radicale_user="${RADICALE_USER:-curodav}"
  fi

  log "Public CalDAV/CardDAV access needs a few values (press Enter to keep a bracketed default)."
  local domain_app tunnel_name radicale_user
  while true; do
    domain_app="$(prompt_default "Public hostname (DOMAIN_APP) -- Radicale will be reached at this SAME hostname's /radicale/ path, not a second subdomain" "$existing_domain_app")"
    looks_like_hostname "$domain_app" && break
    warn "Doesn't look like a hostname (e.g. app.example.com) -- try again."
  done
  tunnel_name="$(prompt_default "Cloudflare Tunnel name" "$existing_tunnel_name")"
  radicale_user="$(prompt_default "Radicale username" "$existing_radicale_user")"

  cat > "$DEPLOY_ENV_FILE" <<EOF
# Generated by 'curodav-ctl install --dav' on $(date -Is). Persisted outside
# any release directory (scripts/curodav-ctl's DEPLOY_ENV_FILE) so it
# survives 'update's disposable git clones. Re-run 'curodav-ctl install
# --dav' to change these values -- it reuses whatever's here as defaults.
DOMAIN_APP=${domain_app}
TUNNEL_NAME=${tunnel_name}
RADICALE_USER=${radicale_user}
EOF
  chmod 0600 "$DEPLOY_ENV_FILE"
  log "Wrote ${DEPLOY_ENV_FILE}."
}

collect_radicale_password() {
  # Sets RADICALE_PASSWORD/RADICALE_PASSWORD_CONFIRM in the calling shell
  # (this function is sourced into run_dav_setup, not run in a subshell) so
  # they can be exported to install-radicale.sh's environment afterward.
  local pw pw_confirm
  while true; do
    read -r -s -p "    Set a Radicale password: " pw; echo
    read -r -s -p "    Confirm: " pw_confirm; echo
    if [ -z "$pw" ]; then
      warn "Password can't be empty -- try again."
    elif [ "$pw" != "$pw_confirm" ]; then
      warn "Didn't match -- try again."
    else
      break
    fi
  done
  RADICALE_PASSWORD="$pw"
  RADICALE_PASSWORD_CONFIRM="$pw_confirm"
}

run_dav_setup() {
  require_root
  local release_dir deploy_src
  release_dir="$(readlink -f "$CURRENT_LINK" 2>/dev/null || true)"
  if [ -z "$release_dir" ] || [ ! -d "${release_dir}/deploy" ]; then
    err "No deployed release with a deploy/ directory found at ${CURRENT_LINK} -- run 'curodav-ctl install' (without --dav) or 'curodav-ctl update' first, so there's a checkout to run deploy/*.sh from."
    exit 1
  fi
  deploy_src="${release_dir}/deploy"

  collect_deploy_env

  log "Locking down the firewall (ssh only)..."
  # firewall.sh refuses to proceed (exit non-zero, caught by this script's
  # own `set -e`) if it detects sshd isn't actually on port 22 -- opening
  # only 22 while sshd listens elsewhere would lock this host's own admin
  # out with no way back in short of provider console access. If that
  # happens here, re-run this whole command as:
  #   sudo FIREWALL_SSH_PORT=<your-actual-ssh-port> curodav-ctl install --dav
  bash "${deploy_src}/firewall.sh"

  collect_radicale_password
  log "Installing Radicale..."
  DEPLOY_ENV_FILE="$DEPLOY_ENV_FILE" RADICALE_PASSWORD="$RADICALE_PASSWORD" RADICALE_PASSWORD_CONFIRM="$RADICALE_PASSWORD_CONFIRM" \
    bash "${deploy_src}/radicale/install-radicale.sh"

  log "Installing the local nginx path-router (/radicale/* -> Radicale, everything else -> curodav)..."
  bash "${deploy_src}/nginx/install-nginx.sh"

  log "Setting up the Cloudflare Tunnel (this will pause for a browser login the first time)..."
  DEPLOY_ENV_FILE="$DEPLOY_ENV_FILE" bash "${deploy_src}/cloudflared/install-cloudflared.sh"

  local radicale_user domain_app
  radicale_user="$(grep -E '^RADICALE_USER=' "$DEPLOY_ENV_FILE" | tail -n1 | cut -d= -f2-)"
  domain_app="$(grep -E '^DOMAIN_APP=' "$DEPLOY_ENV_FILE" | tail -n1 | cut -d= -f2-)"

  if [ -f "$ENV_FILE" ]; then
    log "Wiring Radicale into ${ENV_FILE}..."
    # CC_RADICALE_URL stays LOOPBACK -- the app talks to Radicale directly
    # over 127.0.0.1, bypassing nginx/the tunnel entirely for its own sync.
    set_env_var CC_RADICALE_URL "http://127.0.0.1:${RADICALE_PORT}/${radicale_user}/"
    set_env_var CC_RADICALE_USER "$radicale_user"
    set_env_var CC_RADICALE_PASSWORD "$RADICALE_PASSWORD"
    # CC_RADICALE_PUBLIC_URL is the one operators/DAVx5/Published Lists
    # actually need off-box -- the real https://DOMAIN_APP/radicale/<user>/
    # address, through nginx + the tunnel.
    set_env_var CC_RADICALE_PUBLIC_URL "https://${domain_app}/radicale/${radicale_user}/"
    if systemctl list-unit-files 2>/dev/null | grep -q "^${APP_NAME}\.service"; then
      log "Restarting ${APP_NAME}.service to pick up Radicale config..."
      systemctl restart "${APP_NAME}.service"
    fi
  else
    warn "${ENV_FILE} doesn't exist yet -- once you run 'curodav-ctl install', add:"
    warn "    CC_RADICALE_URL=http://127.0.0.1:${RADICALE_PORT}/${radicale_user}/"
    warn "    CC_RADICALE_USER=${radicale_user}"
    warn "    CC_RADICALE_PASSWORD=${RADICALE_PASSWORD}"
    warn "    CC_RADICALE_PUBLIC_URL=https://${domain_app}/radicale/${radicale_user}/"
  fi
  unset RADICALE_PASSWORD RADICALE_PASSWORD_CONFIRM

  radicale_reachability_check
  log "DAV setup complete. DAVx5 account: https://${domain_app}/radicale/${radicale_user}/ (user: ${radicale_user})"
}

# --- subcommands ---------------------------------------------------------------
cmd_install() {
  require_root

  # 'install --dav' retrofits DAV access onto an already-installed app (or
  # is run standalone any time later) -- it deliberately skips every app
  # install step below and does ONLY the Radicale/Cloudflare Tunnel setup.
  if [ "${DAV_ONLY:-0}" -eq 1 ]; then
    run_dav_setup
    return
  fi

  ensure_user
  ensure_dirs

  if [ ! -f "$REPO_URL_FILE" ]; then
    local repo_url
    repo_url="$(resolve_repo_url_for_install)"
    log "Using repo URL: ${repo_url}"
    printf '%s\n' "$repo_url" > "$REPO_URL_FILE"
    chown "$APP_USER":"$APP_USER" "$REPO_URL_FILE"
    chmod 0644 "$REPO_URL_FILE"
  else
    warn "Repo URL already recorded at ${REPO_URL_FILE}, reusing it."
  fi

  ensure_uv
  write_env_template
  write_unit
  self_install
  cmd_update
  systemctl enable --now "${APP_NAME}.service"
  log "Installed and started ${APP_NAME}.service."
  log "Edit ${ENV_FILE} then 'systemctl restart ${APP_NAME}' if you need to change config."

  # --- optional: admin login up front, instead of the web /setup flow ---
  local admin_user
  admin_user="$(prompt_default "Set an admin username now? Leave blank to use the web /setup flow instead" "")"
  if [ -n "$admin_user" ]; then
    local admin_pass admin_pass_confirm
    while true; do
      read -r -s -p "    Password for '${admin_user}': " admin_pass; echo
      read -r -s -p "    Confirm: " admin_pass_confirm; echo
      if [ -z "$admin_pass" ]; then
        warn "Password can't be empty -- try again."
      elif [ "$admin_pass" != "$admin_pass_confirm" ]; then
        warn "Didn't match -- try again."
      else
        break
      fi
    done
    set_env_var CC_AUTH_USERNAME "$admin_user"
    set_env_var CC_AUTH_PASSWORD "$admin_pass"
    unset admin_pass admin_pass_confirm
    systemctl restart "${APP_NAME}.service"
    log "Admin login set for '${admin_user}'."
  else
    log "Skipped -- visit /setup on first load to create the account instead."
  fi

  # --- optional: chain straight into DAV setup ---
  local setup_dav
  setup_dav="$(prompt_default "Set up public CalDAV/CardDAV access now (Radicale + Cloudflare Tunnel)? [y/N]" "N")"
  if [[ "$setup_dav" =~ ^[Yy]([Ee][Ss])?$ ]]; then
    run_dav_setup
  else
    log "Skipped. Run 'curodav-ctl install --dav' any time later to add it."
  fi
}

cmd_update() {
  require_root
  ensure_uv

  local repo_url
  repo_url="$(load_repo_url)"

  local tmp_clone
  tmp_clone="$(mktemp -d)"
  trap 'rm -rf "$tmp_clone"' RETURN

  log "Cloning ${repo_url} (${GIT_BRANCH})..."
  git clone --depth 1 --branch "$GIT_BRANCH" "$repo_url" "$tmp_clone"

  local hash release_name release_dir
  hash="$(git -C "$tmp_clone" rev-parse --short HEAD)"
  release_name="release_$(date +%Y%m%d_%H%M%S)_${hash}"
  release_dir="${RELEASES_DIR}/${release_name}"

  log "Building release ${release_name}..."
  rsync -a --exclude .git "$tmp_clone/" "$release_dir/"
  chown -R "$APP_USER":"$APP_USER" "$release_dir"

  # --- build_commands (from deployment_manifest, run as APP_USER) ---
  su -s /bin/bash "$APP_USER" -c "
    set -euo pipefail
    export HOME='${SHARED_DIR}'
    cd '${release_dir}/webapp'
    uv sync --frozen --no-dev
  "

  if [ ! -x "${release_dir}/.venv/bin/python" ]; then
    err "Build did not produce ${release_dir}/.venv/bin/python -- aborting, nothing swapped."
    rm -rf "$release_dir"
    exit 1
  fi

  local old_current=""
  if [ -L "$CURRENT_LINK" ]; then
    old_current="$(readlink -f "$CURRENT_LINK")"
  fi

  log "Swapping current -> ${release_name}..."
  atomic_symlink "$release_dir" "$CURRENT_LINK"

  log "Restarting ${APP_NAME}.service..."
  systemctl restart "${APP_NAME}.service"

  log "Health-checking http://127.0.0.1:${TARGET_PORT}${HEALTH_PATH} ..."
  if health_check; then
    log "Health check passed."
    if [ -n "$old_current" ] && [ "$old_current" != "$release_dir" ]; then
      atomic_symlink "$old_current" "$PREVIOUS_LINK"
    fi
    prune_releases
    log "Deploy complete: ${release_name}"
    radicale_reachability_check
  else
    err "Health check FAILED. Rolling back..."
    if [ -n "$old_current" ]; then
      atomic_symlink "$old_current" "$CURRENT_LINK"
      systemctl restart "${APP_NAME}.service"
      err "Rolled back to previous release ($(basename "$old_current"))."
    else
      err "No previous release to roll back to (this was the first deploy)."
    fi
    rm -rf "$release_dir"
    exit 1
  fi
}

cmd_remove() {
  require_root
  warn "This will stop ${APP_NAME}, delete its systemd unit, remove the"
  warn "'${APP_USER}' system user, and wipe ${BASE_DIR} (all releases + data)."
  read -r -p "Type 'yes' to confirm: " confirm
  if [ "$confirm" != "yes" ]; then
    err "Aborted."
    exit 1
  fi

  systemctl stop "${APP_NAME}.service" 2>/dev/null || true
  systemctl disable "${APP_NAME}.service" 2>/dev/null || true
  rm -f "$UNIT_FILE"
  systemctl daemon-reload

  if id -u "$APP_USER" >/dev/null 2>&1; then
    userdel "$APP_USER" 2>/dev/null || true
  fi

  rm -rf "$BASE_DIR"
  log "Removed ${APP_NAME}. ${INSTALLED_CTL} was left in place -- 'rm ${INSTALLED_CTL}' if you want it gone too."
}

# --- dispatch -------------------------------------------------------------------
case "${1:-}" in
  install)
    DAV_ONLY=0
    if [ "${2:-}" = "--dav" ]; then
      DAV_ONLY=1
    elif [ -n "${2:-}" ]; then
      echo "Usage: curodav-ctl install [--dav]" >&2
      exit 2
    fi
    cmd_install
    ;;
  update)  cmd_update ;;
  remove)  cmd_remove ;;
  *)
    echo "Usage: curodav-ctl {install [--dav]|update|remove}" >&2
    exit 2
    ;;
esac
