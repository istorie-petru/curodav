#!/usr/bin/env bash
# curodav-ctl -- install / update / remove Command Center Web (curodav)
# on a Debian 12 LXC, no Docker, systemd-managed, release/symlink deploys.
#
# This script lives IN the app repo (scripts/curodav-ctl), not in a
# separate infra repo, and is self-aware of where it came from -- it does
# not hardcode REPO_URL. See "Repo URL detection" below.
#
# Bootstrap (fresh LXC, first install):
#   git clone https://github.com/istorie-petru/curodav.git /tmp/bootstrap
#   sudo /tmp/bootstrap/scripts/curodav-ctl install
#   rm -rf /tmp/bootstrap   # install already copied itself to /usr/local/bin
#
# Day to day, once installed:
#   sudo curodav-ctl update    # deploy latest main, atomic swap, auto-rollback
#   sudo curodav-ctl remove    # tear down (destructive, confirms)
#
# Layout:
#   /srv/curodav/releases/release_<timestamp>_<hash>/   one per deploy, uv-built
#   /srv/curodav/current -> releases/<latest>            atomically swapped
#   /srv/curodav/previous -> releases/<prior>             swap target for rollback
#   /srv/curodav/shared/.env                              persistent config (EnvironmentFile)
#   /srv/curodav/shared/repo_url                          persisted origin URL (see below)
#   /srv/curodav/shared/data/                             SQLite cache + backups (survives swaps)
#
# Repo URL detection:
#   `install` needs a repo to clone. It never hardcodes one; instead:
#     1. $CURODAV_REPO_URL env var, if set (explicit override -- also how
#        you'd point this at a fork, or run it from a separate infra repo
#        per the "Option B" layout instead of the in-repo "Option A" this
#        file assumes).
#     2. Otherwise, `git remote get-url origin` from wherever THIS script
#        currently sits on disk -- which is why the bootstrap flow above
#        clones the app repo to /tmp/bootstrap first and runs the script
#        from inside that clone, rather than curl-ing just the raw file.
#   Whichever URL wins gets written to shared/repo_url so `update` and
#   `remove` (run later, against the copy at /usr/local/bin, which has no
#   git context of its own) know where to clone from without re-detecting.
set -euo pipefail

# --- manifest-derived constants (deployment_manifest for curodav) ----------
APP_NAME="curodav"
APP_USER="curodav"
GIT_BRANCH="main"
TARGET_PORT=8000
HEALTH_PATH="/"
KEEP_RELEASES=5
UV_INSTALL_DIR="/usr/local/bin"
INSTALLED_CTL="/usr/local/bin/${APP_NAME}-ctl"

BASE_DIR="/srv/${APP_NAME}"
RELEASES_DIR="${BASE_DIR}/releases"
SHARED_DIR="${BASE_DIR}/shared"
DATA_DIR="${SHARED_DIR}/data"
CURRENT_LINK="${BASE_DIR}/current"
PREVIOUS_LINK="${BASE_DIR}/previous"
ENV_FILE="${SHARED_DIR}/.env"
REPO_URL_FILE="${SHARED_DIR}/repo_url"
UNIT_FILE="/etc/systemd/system/${APP_NAME}.service"

# --- colored logging ---------------------------------------------------------
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
log()  { echo -e "${GREEN}==>${NC} $*"; }
warn() { echo -e "${YELLOW}==>${NC} $*"; }
err()  { echo -e "${RED}==>${NC} $*" >&2; }

require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    err "curodav-ctl must run as root (sudo)."
    exit 1
  fi
}

# --- repo URL: detect once (install), persist, load thereafter -------------
detect_repo_url_from_self() {
  # Works only when this script is still sitting inside a git working tree
  # (the bootstrap clone at /tmp/bootstrap) -- not once it's a bare copy
  # at /usr/local/bin, which is the whole reason install() persists it.
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if git -C "$script_dir" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "$script_dir" remote get-url origin 2>/dev/null || true
  fi
}

resolve_repo_url_for_install() {
  if [ -n "${CURODAV_REPO_URL:-}" ]; then
    echo "$CURODAV_REPO_URL"
    return
  fi
  local detected
  detected="$(detect_repo_url_from_self)"
  if [ -n "$detected" ]; then
    echo "$detected"
    return
  fi
  err "Could not determine the app repo's URL."
  err "Run this from inside a git clone of the app repo, e.g.:"
  err "    git clone <repo-url> /tmp/bootstrap && sudo /tmp/bootstrap/scripts/curodav-ctl install"
  err "or set it explicitly:"
  err "    sudo CURODAV_REPO_URL=<repo-url> -E curodav-ctl install"
  exit 1
}

load_repo_url() {
  if [ -n "${CURODAV_REPO_URL:-}" ]; then
    echo "$CURODAV_REPO_URL"
    return
  fi
  if [ -f "$REPO_URL_FILE" ]; then
    cat "$REPO_URL_FILE"
    return
  fi
  err "${REPO_URL_FILE} not found -- has 'install' been run yet?"
  exit 1
}

# --- shared helpers -----------------------------------------------------------
ensure_user() {
  if ! id -u "$APP_USER" >/dev/null 2>&1; then
    log "Creating system user '$APP_USER'..."
    useradd --system --home-dir "$SHARED_DIR" --shell /usr/sbin/nologin "$APP_USER"
  fi
}

ensure_dirs() {
  log "Creating directory layout under ${BASE_DIR}..."
  install -d -o "$APP_USER" -g "$APP_USER" "$RELEASES_DIR" "$SHARED_DIR" \
    "$DATA_DIR" "$DATA_DIR/backups"
}

ensure_uv() {
  if ! command -v uv >/dev/null 2>&1; then
    log "Installing uv (system-wide, ${UV_INSTALL_DIR})..."
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="$UV_INSTALL_DIR" sh
  fi
}

self_install() {
  # Copies whatever script is currently running to /usr/local/bin, so
  # `update`/`remove` (and GitHub Actions' `curodav-ctl update` over SSH)
  # work without the bootstrap clone sticking around. `install` (a temp
  # file + rename) is safe to run even when overwriting the copy of this
  # same script currently executing -- the running process keeps reading
  # from the old inode until it exits.
  local self_path
  self_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  if [ "$(readlink -f "$self_path")" != "$(readlink -f "$INSTALLED_CTL" 2>/dev/null || echo "")" ]; then
    log "Installing this script to ${INSTALLED_CTL}..."
    install -m 0755 "$self_path" "$INSTALLED_CTL"
  fi
}

write_env_template() {
  if [ -f "$ENV_FILE" ]; then
    warn ".env already exists at ${ENV_FILE}, leaving it untouched."
    return
  fi
  log "Generating ${ENV_FILE} with a random auth-session secret..."
  local secret
  secret="$(openssl rand -hex 32)"
  cat > "$ENV_FILE" <<EOF
# curodav configuration -- generated by curodav-ctl install on $(date -Is)
# This file is EnvironmentFile for the systemd unit. It lives in shared/,
# outside any release directory, so it survives every 'update' swap.

# SQLite cache + data-health backups. Must stay in shared/, not inside a
# release directory, or every deploy would start from an empty database.
CC_DB_PATH=${DATA_DIR}/cache.sqlite
CC_BACKUP_DIR=${DATA_DIR}/backups

# Background sync interval (seconds).
CC_SYNC_INTERVAL=60

# Forces the first-run /setup flow until an account is created, instead of
# running fully open. Do not unset this on a deploy reachable off localhost.
CC_DEPLOY_MODE=production

# Auto-generated session-signing secret (rotate by editing this and
# restarting -- invalidates all existing sessions).
CC_AUTH_SECRET=${secret}

# Uncomment to pre-provision the single-user login instead of using /setup:
# CC_AUTH_USERNAME=you
# CC_AUTH_PASSWORD=change-me

# Optional CalDAV/CardDAV sync against a Radicale server. Unset = app runs
# standalone against its local SQLite cache only.
# CC_RADICALE_URL=http://127.0.0.1:5232/curodav/
# CC_RADICALE_USER=curodav
# CC_RADICALE_PASSWORD=
# CC_CALENDAR_COLLECTION=calendar
# CC_TASKS_COLLECTION=tasks
# CC_CONTACTS_COLLECTION=contacts
EOF
  chown root:"$APP_USER" "$ENV_FILE"
  chmod 0640 "$ENV_FILE"
}

write_unit() {
  local repo_url
  repo_url="$(load_repo_url)"
  log "Writing systemd unit to ${UNIT_FILE}..."
  cat > "$UNIT_FILE" <<EOF
# curodav -- managed by curodav-ctl. Re-generated on every 'install';
# use a drop-in at ${UNIT_FILE}.d/ for local overrides instead of editing
# this file directly, or they will be silently overwritten.
[Unit]
Description=Command Center Web (curodav) -- personal organizer PWA
Documentation=${repo_url}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_USER}
# Required to literally be the 'current' symlink (release/rollback target),
# not a subdirectory of it -- see --app-dir below for why that's still
# enough for the app to import correctly.
WorkingDirectory=${CURRENT_LINK}
EnvironmentFile=${ENV_FILE}
# The repo is a uv workspace (root pyproject.toml, webapp/ as member), so
# 'uv sync' from webapp/ puts the venv at the release root, not under
# webapp/. --app-dir tells uvicorn to add webapp/ to sys.path itself
# (equivalent to running with cwd=.../current/webapp) without requiring
# WorkingDirectory to point there.
ExecStart=${CURRENT_LINK}/.venv/bin/python -m uvicorn src.main:app --host 0.0.0.0 --port ${TARGET_PORT} --proxy-headers --app-dir ${CURRENT_LINK}/webapp
Restart=on-failure
RestartSec=3

# Hardening.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=${SHARED_DIR}

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
}

health_check() {
  local url="http://127.0.0.1:${TARGET_PORT}${HEALTH_PATH}"
  local attempts=10
  for i in $(seq 1 "$attempts"); do
    if curl -fsS -o /dev/null "$url"; then
      return 0
    fi
    sleep 1
  done
  return 1
}

atomic_symlink() {
  # $1 = target, $2 = link name. Uses a temp symlink + rename(2) via `mv -T`
  # so readers never observe a missing/half-written link.
  local target="$1" link="$2" tmp
  tmp="$(mktemp -u "${link}.XXXXXX")"
  ln -s "$target" "$tmp"
  mv -T "$tmp" "$link"
}

prune_releases() {
  log "Pruning old releases (keeping last ${KEEP_RELEASES})..."
  # shellcheck disable=SC2012
  ls -1dt "${RELEASES_DIR}"/release_* 2>/dev/null | tail -n +$((KEEP_RELEASES + 1)) | \
    while read -r old; do
      # Never delete whatever current/previous still point at.
      if [ "$(readlink -f "$CURRENT_LINK" 2>/dev/null)" = "$(readlink -f "$old")" ]; then continue; fi
      if [ "$(readlink -f "$PREVIOUS_LINK" 2>/dev/null)" = "$(readlink -f "$old")" ]; then continue; fi
      rm -rf "$old"
    done
}

# --- subcommands ---------------------------------------------------------------
cmd_install() {
  require_root
  ensure_user
  ensure_dirs

  if [ ! -f "$REPO_URL_FILE" ]; then
    local repo_url
    repo_url="$(resolve_repo_url_for_install)"
    log "Using repo URL: ${repo_url}"
    printf '%s\n' "$repo_url" > "$REPO_URL_FILE"
    chown "$APP_USER":"$APP_USER" "$REPO_URL_FILE"
    chmod 0644 "$REPO_URL_FILE"
  else
    warn "Repo URL already recorded at ${REPO_URL_FILE}, reusing it."
  fi

  ensure_uv
  write_env_template
  write_unit
  self_install
  cmd_update
  systemctl enable --now "${APP_NAME}.service"
  log "Installed and started ${APP_NAME}.service."
  log "Edit ${ENV_FILE} then 'systemctl restart ${APP_NAME}' if you need to change config."
}

cmd_update() {
  require_root
  ensure_uv

  local repo_url
  repo_url="$(load_repo_url)"

  local tmp_clone
  tmp_clone="$(mktemp -d)"
  trap 'rm -rf "$tmp_clone"' RETURN

  log "Cloning ${repo_url} (${GIT_BRANCH})..."
  git clone --depth 1 --branch "$GIT_BRANCH" "$repo_url" "$tmp_clone"

  local hash release_name release_dir
  hash="$(git -C "$tmp_clone" rev-parse --short HEAD)"
  release_name="release_$(date +%Y%m%d_%H%M%S)_${hash}"
  release_dir="${RELEASES_DIR}/${release_name}"

  log "Building release ${release_name}..."
  rsync -a --exclude .git "$tmp_clone/" "$release_dir/"
  chown -R "$APP_USER":"$APP_USER" "$release_dir"

  # --- build_commands (from deployment_manifest, run as APP_USER) ---
  su -s /bin/bash "$APP_USER" -c "
    set -euo pipefail
    export HOME='${SHARED_DIR}'
    cd '${release_dir}/webapp'
    uv sync --frozen --no-dev
  "

  if [ ! -x "${release_dir}/.venv/bin/python" ]; then
    err "Build did not produce ${release_dir}/.venv/bin/python -- aborting, nothing swapped."
    rm -rf "$release_dir"
    exit 1
  fi

  local old_current=""
  if [ -L "$CURRENT_LINK" ]; then
    old_current="$(readlink -f "$CURRENT_LINK")"
  fi

  log "Swapping current -> ${release_name}..."
  atomic_symlink "$release_dir" "$CURRENT_LINK"

  log "Restarting ${APP_NAME}.service..."
  systemctl restart "${APP_NAME}.service"

  log "Health-checking http://127.0.0.1:${TARGET_PORT}${HEALTH_PATH} ..."
  if health_check; then
    log "Health check passed."
    if [ -n "$old_current" ] && [ "$old_current" != "$release_dir" ]; then
      atomic_symlink "$old_current" "$PREVIOUS_LINK"
    fi
    prune_releases
    log "Deploy complete: ${release_name}"
  else
    err "Health check FAILED. Rolling back..."
    if [ -n "$old_current" ]; then
      atomic_symlink "$old_current" "$CURRENT_LINK"
      systemctl restart "${APP_NAME}.service"
      err "Rolled back to previous release ($(basename "$old_current"))."
    else
      err "No previous release to roll back to (this was the first deploy)."
    fi
    rm -rf "$release_dir"
    exit 1
  fi
}

cmd_remove() {
  require_root
  warn "This will stop ${APP_NAME}, delete its systemd unit, remove the"
  warn "'${APP_USER}' system user, and wipe ${BASE_DIR} (all releases + data)."
  read -r -p "Type 'yes' to confirm: " confirm
  if [ "$confirm" != "yes" ]; then
    err "Aborted."
    exit 1
  fi

  systemctl stop "${APP_NAME}.service" 2>/dev/null || true
  systemctl disable "${APP_NAME}.service" 2>/dev/null || true
  rm -f "$UNIT_FILE"
  systemctl daemon-reload

  if id -u "$APP_USER" >/dev/null 2>&1; then
    userdel "$APP_USER" 2>/dev/null || true
  fi

  rm -rf "$BASE_DIR"
  log "Removed ${APP_NAME}. ${INSTALLED_CTL} was left in place -- 'rm ${INSTALLED_CTL}' if you want it gone too."
}

# --- dispatch -------------------------------------------------------------------
case "${1:-}" in
  install) cmd_install ;;
  update)  cmd_update ;;
  remove)  cmd_remove ;;
  *)
    echo "Usage: curodav-ctl {install|update|remove}" >&2
    exit 2
    ;;
esac
