# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
*.so

# Virtualenvs
.venv/

# Editor / OS
.DS_Store
*.swp
*.swo

# Dev-only Radicale data -- the webapp's throwaway local CalDAV/CardDAV
# instance. The collections hold real calendar/task/contact data plus
# backups; the users file holds dev credentials. Neither belongs in git.
# .dev/radicale/config (the read-only dev config) IS tracked.
webapp/.dev/radicale/collections/
webapp/.dev/radicale/collections.bak-*/
webapp/.dev/radicale/users

# Deploy runtime secrets -- scripts/curodav-ctl generates these on the
# target host at install time (.env with a random CC_AUTH_SECRET, the
# detected repo URL); neither ever exists inside this repo checkout, but
# ignored here too in case anyone runs curodav-ctl from a local clone
# instead of the documented /tmp/bootstrap path.
.env
shared/.env

# Agent tooling state -- not part of the app, not public-facing.
.opencode

# Editor / OS state that sometimes leaks in despite the patterns above.
.idea/
.vscode/