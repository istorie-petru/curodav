# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
*.so

# Virtualenvs
.venv/

# Editor / OS
.DS_Store
*.swp
*.swo

# Dev-only Radicale data -- the webapp's throwaway local CalDAV/CardDAV
# instance. The collections hold real calendar/task/contact data plus
# backups; the users file holds dev credentials. Neither belongs in git.
# .dev/radicale/config (the read-only dev config) IS tracked.
webapp/.dev/radicale/collections/
webapp/.dev/radicale/collections.bak-*/
webapp/.dev/radicale/users

# Deploy runtime secrets -- generated by deploy/*/install.sh from the
# *.example templates (same rule as the dev Radicale above: never commit
# credentials). The read-only configs in these dirs ARE tracked.
deploy/docker/radicale/users
deploy/systemd/radicale/users