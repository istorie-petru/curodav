# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
*.so

# Virtualenvs
.venv/

# Editor / OS
.DS_Store
*.swp
*.swo

# Dev-only Radicale data -- the webapp's throwaway local CalDAV/CardDAV
# instance. The collections hold real calendar/task/contact data plus
# backups; the users file holds dev credentials. Neither belongs in git.
# .dev/radicale/config (the read-only dev config) IS tracked.
webapp/.dev/radicale/collections/
webapp/.dev/radicale/collections.bak-*/
webapp/.dev/radicale/users

# Deploy runtime secrets -- scripts/curodav-ctl generates these on the
# target host at install time (.env with a random CC_AUTH_SECRET, the
# detected repo URL); neither ever exists inside this repo checkout, but
# ignored here too in case anyone runs curodav-ctl from a local clone
# instead of the documented /tmp/bootstrap path.
.env
shared/.env

# Local tooling state -- not part of the app, not public-facing.
.opencode
.claude

# Personal dev tooling -- not part of the app. git-commit.sh: low-ceremony
# "save my progress" commits. git-push.sh: squashes whatever's unpushed into
# one commit, optionally bumps VERSION/CHANGELOG.md and tags+pushes a
# release, cutting a GitHub release via `gh` if it's available.
/git-commit.sh
/git-push.sh

# Personal reference notes -- a cheat sheet for the release process
# (merging/squashing commits, tagging, gh release, the wiki repo), not
# documentation for contributors (that's CONTRIBUTING.md, public).
/LOCAL_RELEASE_GUIDE.md

# 2026-09-29 direct correction: this reference folder (real Google
# Calendar flair photos/icons, plus PNGs rasterized from Google's own
# icon SVGs) was mistakenly committed and pushed to this public repo --
# exactly the copyrighted-content problem flairs.py's own module
# docstring already explains was fixed once (see that file's header).
# Untracked here going forward; the commits that added it were rewritten
# out of history in the same slice that added this line (git-filter-repo,
# see LOCAL_RELEASE_GUIDE.md). Stays on disk locally as an operator's own
# reference for populating their own flairs_dir -- never in git again.
/google-calendar-flairs/

# Test-run artifacts that shouldn't have been committed.
webapp/encrypted.data
.test_out.log

# Editor / OS state that sometimes leaks in despite the patterns above.
.idea/
.vscode/